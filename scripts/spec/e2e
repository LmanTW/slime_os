def item(kind: str, uid: str, slug: str, intent: str = "planned", target: str = "feature_exam", extra: str = "", controls: int | None = 2, more: str = "") -> str:
    floor = "" if controls is None else f' h.atLeast "negativeControlsRefused" {controls};'
