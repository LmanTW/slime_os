-- Pure renderer for the data volume: the Rust constants the guest reader validates with, and the Python
-- constants and volume-header `struct` the host builder writes with. `schema.zt` owns the effectful write
-- entry, so the reflected header record folds before host filesystem effects lower.

refl ::= import stdlib.reflect;
n ::= import stdlib.num;
l ::= import stdlib.list;
t ::= import stdlib.text;
c ::= import wire.codec;
py ::= import wire.python;

Format :: type {
  formatVersion : Int;
  volumeMagic : Int;
  kindFrameStore : Int;
  sectorBytes : Int;
  firstLba : Int;
  gptEntryCount : Int;
  gptEntryBytes : Int;
  maxPayloadBytes : Int;
  partitionTypeGuid : Text;
  partitionName : Text;
  diskGuidDomain : Text;
  partitionGuidDomain : Text;
  refusalClasses : List Text;
  volumeHeaderFields : List refl.SchemaField;
  volumeHeaderLayout : List c.WireField;
};

-- `"a", "b"`: quoted and comma-separated, with no trailing separator. Refusal classes are lowercase words
-- joined by `-`, so they need no escaping in either language.
quoted :: List Text -> Text
= names => match names {
  | {;} => "";
  | { name; ...rest } => match rest {
    | {;} => t.join "" { "\""; name; "\""; };
    | { next; ...more } => t.join "" { "\""; name; "\", "; quoted rest; };
  };
};

layoutBytes :: List c.WireField -> Int
= fields => match fields {
  | {;} => 0;
  | { field; ...rest } => field.width + layoutBytes rest;
};

-- The volume header as a Python `struct`. `wire.python` refuses the record unless the reflected field names
-- are the layout's, in order, and its widths sum to the header's size.
records :: Format -> List py.WireRecord
= format => {
  {
    pythonName = "VOLUME_HEADER";
    constPrefix = "VOLUME_HEADER";
    size = layoutBytes format.volumeHeaderLayout;
    trailingPadding = 0;
    fields = format.volumeHeaderFields;
    layout = format.volumeHeaderLayout;
  };
};

rustBindings :: Format -> Text
= format => t.join "" {
  "// @generated by contracts/data-volume/v1/gen.zt; do not edit.\n";
  "// Source contract: contracts/data-volume/v1/schema.zt\n\n";
  "pub const FORMAT_VERSION: u16 = "; n.toText format.formatVersion; ";\n";
  "pub const VOLUME_MAGIC: u32 = "; n.toText format.volumeMagic; ";\n";
  "pub const KIND_FRAME_STORE: u16 = "; n.toText format.kindFrameStore; ";\n";
  "pub const SECTOR_BYTES: usize = "; n.toText format.sectorBytes; ";\n";
  "pub const FIRST_LBA: u64 = "; n.toText format.firstLba; ";\n";
  "pub const GPT_ENTRY_COUNT: u32 = "; n.toText format.gptEntryCount; ";\n";
  "pub const GPT_ENTRY_BYTES: u32 = "; n.toText format.gptEntryBytes; ";\n";
  "pub const MAX_PAYLOAD_BYTES: u64 = "; n.toText format.maxPayloadBytes; ";\n";
  "pub const PARTITION_TYPE_GUID: &str = \""; format.partitionTypeGuid; "\";\n";
  "pub const PARTITION_NAME: &str = \""; format.partitionName; "\";\n";
  "pub const DISK_GUID_DOMAIN: &str = \""; format.diskGuidDomain; "\";\n";
  "pub const PARTITION_GUID_DOMAIN: &str = \""; format.partitionGuidDomain; "\";\n\n";
  "/// The refusal classes, in the order of the first check that can produce each.\n";
  "pub const REFUSAL_CLASSES: [&str; "; n.toText (l.length format.refusalClasses); "] = [";
  quoted format.refusalClasses; "];\n\n";
  "pub const VOLUME_HEADER_BYTES: usize = "; n.toText (layoutBytes format.volumeHeaderLayout); ";\n";
  c.offsetConsts "HEADER" 0 format.volumeHeaderLayout;
};

pythonBindings :: Format -> Text
= format => t.join "" {
  "# @generated by contracts/data-volume/v1/gen.zt; do not edit.\n";
  "# Source contract: contracts/data-volume/v1/schema.zt\n\n";
  "import struct\n\n";
  "FORMAT_VERSION = "; n.toText format.formatVersion; "\n";
  "VOLUME_MAGIC = "; n.toText format.volumeMagic; "\n";
  "KIND_FRAME_STORE = "; n.toText format.kindFrameStore; "\n";
  "SECTOR_BYTES = "; n.toText format.sectorBytes; "\n";
  "FIRST_LBA = "; n.toText format.firstLba; "\n";
  "GPT_ENTRY_COUNT = "; n.toText format.gptEntryCount; "\n";
  "GPT_ENTRY_BYTES = "; n.toText format.gptEntryBytes; "\n";
  "MAX_PAYLOAD_BYTES = "; n.toText format.maxPayloadBytes; "\n";
  "PARTITION_TYPE_GUID = \""; format.partitionTypeGuid; "\"\n";
  "PARTITION_NAME = \""; format.partitionName; "\"\n";
  "DISK_GUID_DOMAIN = \""; format.diskGuidDomain; "\"\n";
  "PARTITION_GUID_DOMAIN = \""; format.partitionGuidDomain; "\"\n";
  "REFUSAL_CLASSES = ("; quoted format.refusalClasses; ")\n";
  "VOLUME_HEADER_BYTES = "; n.toText (layoutBytes format.volumeHeaderLayout); "\n\n";
  py.renderRecords (records format);
};

valid :: Format -> Bool
= format => py.recordsValid (records format);

render :: Format -> { rust : Text; python : Text; }
= format => if valid format
then { rust = rustBindings format; python = pythonBindings format; }
else { rust = "INVALID_DATA_VOLUME_SCHEMA"; python = "INVALID_DATA_VOLUME_SCHEMA"; };

{ render =; Format =; }
