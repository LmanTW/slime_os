-- Schema-reflected Python + Rust renderer for resource-reader/v1.
-- Shared struct.Struct mechanics live in the `wire.python` package module;
-- shared Rust scalar-const mechanics live in `wire.rust`.

env ::= import stdlib.env;
fs ::= import stdlib.fs;
refl ::= import stdlib.reflect;
n ::= import stdlib.num;
t ::= import stdlib.text;
s ::= import "schema.zt";
w ::= import wire.python;
r ::= import wire.rust;

Format :: type {
  magicTag : Text;
  formatVersion : Int;
  headerBytes : Int;
  entryBytes : Int;
  maxRows : Int;
  identityDomain : Text;
  resourceEntropyAuthority : Int;
  resourceZenohGrants : Int;
  resourceZenohLimits : Int;
  resourceNetworkDestinations : Int;
  resourceNetworkInterfaces : Int;
  resourceNetworkApplications : Int;
  resourceBlockRingAuthority : Int;
  headerFields : List refl.SchemaField;
  entryFields : List refl.SchemaField;
  headerLayout : List w.WireField;
  entryLayout : List w.WireField;
};

records :: Format -> List w.WireRecord = format => {
  { pythonName = "RESOURCE_READER_HEADER"; constPrefix = "RESOURCE_READER"; size = format.headerBytes; trailingPadding = 0; fields = format.headerFields; layout = format.headerLayout; };
  { pythonName = "RESOURCE_READER_ENTRY"; constPrefix = "RESOURCE_READER_ENTRY"; size = format.entryBytes; trailingPadding = 0; fields = format.entryFields; layout = format.entryLayout; };
};

pythonResource :: Text -> Int -> Text
  = name value => w.join { "RESOURCE_READER_"; name; " = "; n.toText value; "\n"; };

pythonBindings :: Format -> Text = format => w.join {
  "RESOURCE_READER_MAGIC = b\""; format.magicTag; "\\0\"\n";
  "RESOURCE_READER_VERSION = "; n.toText format.formatVersion; "\n";
  "RESOURCE_READER_HEADER_BYTES = "; n.toText format.headerBytes; "\n";
  "RESOURCE_READER_ENTRY_BYTES = "; n.toText format.entryBytes; "\n";
  "MAX_RESOURCE_READER_ROWS = "; n.toText format.maxRows; "\n";
  "RESOURCE_READER_IDENTITY_DOMAIN = b\""; format.identityDomain; "\"\n";
  pythonResource "ENTROPY_AUTHORITY" format.resourceEntropyAuthority;
  pythonResource "ZENOH_GRANTS" format.resourceZenohGrants;
  pythonResource "ZENOH_LIMITS" format.resourceZenohLimits;
  pythonResource "NETWORK_DESTINATIONS" format.resourceNetworkDestinations;
  pythonResource "NETWORK_INTERFACES" format.resourceNetworkInterfaces;
  pythonResource "NETWORK_APPLICATIONS" format.resourceNetworkApplications;
  pythonResource "BLOCK_RING_AUTHORITY" format.resourceBlockRingAuthority;
  w.renderRecords (records format);
};

-- Schema-owned scalars shared with boot-contracts/src/resource_reader.rs.
-- The derived MAX_BYTES and the decode machinery stay hand-written in that
-- module.
rustBindings :: Format -> Text = format => r.join {
  "// @generated by contracts/resource-reader/v1/gen_rust.zt; do not edit.\n";
  "// Source contract: contracts/resource-reader/v1/schema.zt\n\n";
  "pub const MAGIC: [u8; 8] = *b\""; format.magicTag; "\\0\";
";
  r.u32Const "FORMAT_VERSION" format.formatVersion;
  r.usizeConst "HEADER_BYTES" format.headerBytes;
  r.usizeConst "ENTRY_BYTES" format.entryBytes;
  r.usizeConst "MAX_ROWS" format.maxRows;
  "pub const IDENTITY_DOMAIN: &[u8] = b\""; format.identityDomain; "\";\n";
  r.u32Const "RESOURCE_ENTROPY_AUTHORITY" format.resourceEntropyAuthority;
  r.u32Const "RESOURCE_ZENOH_GRANTS" format.resourceZenohGrants;
  r.u32Const "RESOURCE_ZENOH_LIMITS" format.resourceZenohLimits;
  r.u32Const "RESOURCE_NETWORK_DESTINATIONS" format.resourceNetworkDestinations;
  r.u32Const "RESOURCE_NETWORK_INTERFACES" format.resourceNetworkInterfaces;
  r.u32Const "RESOURCE_NETWORK_APPLICATIONS" format.resourceNetworkApplications;
  r.u32Const "RESOURCE_BLOCK_RING_AUTHORITY" format.resourceBlockRingAuthority;
};

render :: Format -> { python : Text; rust : Text; }
  = format => if w.recordsValid (records format)
    then { python = pythonBindings format; rust = rustBindings format; }
    else { python = "INVALID_RESOURCE_READER_SCHEMA"; rust = "INVALID_RESOURCE_READER_SCHEMA"; };

main :: { write : FsWrite; env : Env; } -> Unit ! { * fs.WholeWriteEffects; * env.GetEffects; }
  = caps => [
    root := env.get caps.env "SLIME_BOOT_BINDINGS_ROOT" ?? ".";
    bindings := render s.format;
    pythonPath := t.join "" { root; "/resource_reader.py"; };
    rustPath := t.join "" { root; "/resource_reader.rs"; };
    fs.writeAll caps.write pythonPath bindings.python;
    fs.writeAll caps.write rustPath bindings.rust
  ];

main
