-- Renders the rmw_zenoh graph exam's synthetic rows as Rust constants for the `zenoh_rmw_graph::` tests.
--
-- The input is the record `schema.zt` describes, decoded by the contract's own `decodeGraph`, so a
-- record the contract refuses never reaches the tests. The output is five lists of `&str` pairs, not a
-- parser: the tests read nothing at run time.

env ::= import stdlib.env;
fs ::= import stdlib.fs;
load ::= import stdlib.load;
t ::= import stdlib.text;
n ::= import stdlib.num;
s ::= import "schema.zt";

pair :: s.Row -> Text
  = row => t.join "" { "    (\""; row.name; "\", \""; row.key; "\"),\n"; };

pairs :: List s.Row -> Text
  = items => match items {
    | {;} => "";
    | { head; ...rest } => t.join "" { pair head; pairs rest; };
  };

size :: Int -> List s.Row -> Int
  = total items => match items {
    | {;} => total;
    | { _; ...rest } => size (total + 1) rest;
  };

constant :: Text -> List s.Row -> Text
  = name items => t.join "" {
    "pub const "; name; ": [(&str, &str); "; n.toText (size 0 items); "] = [\n";
    pairs items;
    "];\n\n";
  };

-- The schema's decoder fixes shape and types; the version, the group sizes and the byte bounds it
-- declares are enforced here, before anything is rendered, so a record the contract's constants forbid
-- never becomes a test constant. A key may hold no quote and no backslash, because it is rendered into a
-- Rust string literal as it stands.

rowOk :: s.Row -> Bool
  = row => t.length row.name <= s.maxNameBytes
    && t.length row.key <= s.maxKeyBytes
    && t.length (t.replace "\"" "" row.key) == t.length row.key
    && t.length (t.replace "\\" "" row.key) == t.length row.key;

everyRowOk :: List s.Row -> Bool
  = items => match items {
    | {;} => true;
    | { head; ...rest } => rowOk head && everyRowOk rest;
  };

groupOk :: Int -> List s.Row -> Bool
  = want items => size 0 items == want && everyRowOk items;

graphOk :: s.Graph -> Bool
  = c => c.formatVersion == s.formatVersion
    && groupOk s.qosCount c.qos
    && groupOk s.tokenCount c.tokens
    && groupOk s.refuseCount c.refuse
    && groupOk s.qosRefuseCount c.qosRefuse
    && groupOk s.ignoredCount c.ignored;

render :: s.Graph -> Text
  = c => t.join "" {
    "// @generated by contracts/zenoh-rmw-graph/v1/gen_rust.zt; do not edit.\n";
    "// Source contract: contracts/zenoh-rmw-graph/v1/schema.zt\n\n";
    "pub const FORMAT_VERSION: u32 = "; n.toText c.formatVersion; ";\n\n";
    constant "QOS" c.qos;
    constant "TOKENS" c.tokens;
    constant "REFUSE" c.refuse;
    constant "QOS_REFUSE" c.qosRefuse;
    constant "IGNORED" c.ignored;
  };

main :: { write : FsWrite; env : Env; load : Load; } -> Unit ! { * fs.WholeWriteEffects; * env.GetEffects; * load.ZtiEffects; }
  = caps => [
    root := env.get caps.env "SLIME_ZENOH_RMW_GRAPH_BINDINGS_ROOT" ?? ".";
    input := env.get caps.env "SLIME_ZENOH_RMW_GRAPH_FIXTURES_PATH" ?? "";
    out := t.join "" { root; "/components/lib/src/zenoh_rmw_graph/fixtures.rs"; };
    match s.decodeGraph (load.zti caps.load input) {
      | #valid { value = c; } => if graphOk c
        then fs.writeAll caps.write out (render c)
        else fs.writeAll caps.write out "INVALID_ZENOH_RMW_GRAPH_FIXTURES";
      | #invalid { errors = _; } => fs.writeAll caps.write out "INVALID_ZENOH_RMW_GRAPH_FIXTURES";
    }
  ];

main
