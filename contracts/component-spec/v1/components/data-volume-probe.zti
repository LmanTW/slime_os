{
  formatVersion = 1;
  name = "data-volume-probe";
  componentType = "application";
  version = "1.0.0";
  owner = "init";
  purpose = "Reads a hash-pinned data volume through a read-only block ring and reports its frame store or the class of the first check that refused it.";
  implementation = {
    provider = "workspace";
    binary = "data-volume-probe";
    contentHash = "";
  };
  provides = [
    "endpoint";
  ];
  requires = [
    "endpoint";
    "sharedBufferFactory";
  ];
  interfaces = [];
  dependencies = [];
  communication = {
    semantic = "none";
    qos = [];
  };
  configuration = [];
  lifecycle = [
    "Initialize";
    "Start";
    "Running";
    "Error";
  ];
  runtime = {
    executionEnvironment = "aarch64-sel4-qemu-virt";
    resource = {
      stackBytes = 16384;
      spawnBudget = 0;
      extraThreads = 0;
      bufferBytePages = 0;
      bufferCount = 0;
      mappingCount = 0;
      loanCount = 0;
      privatePageQuota = 0;
    };
    devices = [];
  };
  health = "optional";
  lifetime = "bounded";
  compatibility = {
    platform = "aarch64-sel4-qemu-virt";
    interface = "contracts/interface-schema/v1";
    dependency = "none";
    resource = "atMost";
    runtime = "exact";
    qos = "none";
  };
  test = {
    testCondition = "the data_volume_check gate boots sel4-data-volume with an honest disk and with disks that each fail one check";
    expectedResult = "the honest volume is read in full and every broken one is refused with its class";
    passFailCriteria = "complete";
    requiredTestEnvironment = "data_volume_check";
  };
}
