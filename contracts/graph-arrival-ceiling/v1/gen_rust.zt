-- Schema-reflected Python + Rust renderer for graph-arrival-ceiling/v1.
-- Shared struct.Struct mechanics live in the `wire.python` package module;
-- shared Rust scalar-const mechanics live in `wire.rust`.

refl ::= import stdlib.reflect;
n ::= import stdlib.num;
w ::= import wire.python;
r ::= import wire.rust;
c ::= import wire.codec;

Format :: type {
  formatVersion : Int;
  headerBytes : Int;
  defaultCeiling : Int;
  maxCeiling : Int;
  headerFields : List refl.SchemaField;
  headerLayout : List w.WireField;
};

records :: Format -> List w.WireRecord = format => {
  { pythonName = "GRAPH_ARRIVAL_CEILING_HEADER"; constPrefix = "GRAPH_ARRIVAL_CEILING"; size = format.headerBytes; trailingPadding = 0; fields = format.headerFields; layout = format.headerLayout; };
};

pythonBindings :: Format -> Text = format => w.join {
  "GRAPH_ARRIVAL_CEILING_MAGIC = b\"SLIMEGA\\0\"\n";
  "GRAPH_ARRIVAL_CEILING_VERSION = "; n.toText format.formatVersion; "\n";
  "GRAPH_ARRIVAL_CEILING_HEADER_BYTES = "; n.toText format.headerBytes; "\n";
  "GRAPH_ARRIVAL_CEILING_DEFAULT = "; n.toText format.defaultCeiling; "\n";
  "GRAPH_ARRIVAL_CEILING_MAX = "; n.toText format.maxCeiling; "\n";
  w.renderRecords (records format);
};

-- Schema-owned scalars and offsets shared with
-- boot-contracts/src/graph_arrival_ceiling.rs. The magic tag and decode
-- machinery stay hand-written in that module.
rustBindings :: Format -> Text = format => r.join {
  "// @generated by contracts/graph-arrival-ceiling/v1/gen_rust.zt; do not edit.\n";
  "// Source contract: contracts/graph-arrival-ceiling/v1/schema.zt\n\n";
  r.u32Const "FORMAT_VERSION" format.formatVersion;
  r.usizeConst "HEADER_BYTES" format.headerBytes;
  r.usizeConst "DEFAULT_CEILING" format.defaultCeiling;
  r.usizeConst "MAX_CEILING" format.maxCeiling;
  "\n"; c.offsetConstsWithEnds "HEADER" 0 format.headerLayout;
};

render :: Format -> { python : Text; rust : Text; }
  = format => if w.recordsValid (records format)
    && c.wireBytes format.headerLayout == format.headerBytes
    && format.defaultCeiling > 0 && format.maxCeiling > format.defaultCeiling
    then { python = pythonBindings format; rust = rustBindings format; }
    else { python = "INVALID_GRAPH_ARRIVAL_CEILING_SCHEMA"; rust = "INVALID_GRAPH_ARRIVAL_CEILING_SCHEMA"; };
{ render =; }
