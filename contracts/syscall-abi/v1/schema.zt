-- Slime OS root-service syscall ABI, version 1.
--
-- Every value here crosses the process boundary between a component and
-- `slime-root`: the operation label a component puts in the IPC message label
-- register, the status code the root returns in reply MR0, and the byte layout
-- of a spawn-grant record staged through the transfer window.
--
-- Before B59 each of these tables was hand-authored in
-- `components/runtime/src/syscall.rs`, re-typed in `slime-root/src/main.rs` and
-- `slime-root/src/ipc.rs`, and restated a third time as prose in
-- `docs/syscall-abi.md`, with nothing forcing the copies to agree. That is not
-- hypothetical: `slime-root/src/console.rs` records a numbering disagreement
-- between the two crates that produced silently garbled keystrokes -- no compile
-- error, only a runtime misdecode. This contract is the single source, and both
-- crates consume the bindings generated from it.
--
-- Numbers are frozen. A component image built against one generation invokes the
-- same label a later root must still answer, so labels are pinned individually
-- rather than derived from declaration order, and gaps are left where retired
-- operations used to live rather than being compacted.

env ::= import stdlib.env;
fs ::= import stdlib.fs;
gen ::= import "gen_rust.zt";
t ::= import stdlib.text;

formatVersion :: Int = 1;

-- One root-served operation. `service` names the mechanism module that owns it
-- in the root; the generated bindings group constants by that service so the
-- userspace wrapper and the root dispatcher address the same namespaces they do
-- today (`lifecycle_labels::EXIT`, `shared_buffer_labels::CREATE`, ...).
Operation :: type { service : Text; name : Text; label : Int; };

operation :: Text -> Text -> Int -> Operation
  = service name label => { service = service; name = name; label = label; };

-- Labels 1, 2, 6, 7, 8, 10, 11, 14, and 16-20 are retired: B46's native-IPC
-- cutover deleted the logical channel, wait-set, and endpoint-create operations
-- that held them. The gaps stay so a component image built before the cutover
-- cannot have a surviving label silently re-mean something else.
operations :: List Operation = {
  operation "lifecycle" "EXIT" 3;
  operation "lifecycle" "UNHEALTHY" 9;
  operation "spawn" "SPAWN" 4;
  operation "fixture" "DIRECTIVE" 5;
  operation "supervision" "STATUS" 12;
  operation "supervision" "DERIVE" 32;
  operation "capabilityTable" "DROP" 13;
  operation "capabilityTable" "OCCUPANCY" 31;
  operation "directory" "DERIVE" 15;
  operation "sharedBuffer" "CREATE" 21;
  operation "sharedBuffer" "RELEASE" 22;
  operation "sharedBuffer" "MAP" 23;
  operation "sharedBuffer" "UNMAP" 24;
  operation "sharedBuffer" "SEAL" 25;
  operation "sharedBuffer" "LOAN" 26;
  operation "sharedBuffer" "LOAN_MAP" 27;
  operation "sharedBuffer" "RETURN" 28;
  operation "sharedBuffer" "REVOKE" 29;
  operation "sharedBuffer" "OCCUPANCY" 30;
  operation "capabilityTransfer" "EXPORT" 33;
  operation "capabilityTransfer" "IMPORT" 34;
  operation "capabilityTransfer" "EXPORT_CANCEL" 35;
  operation "capabilityTransfer" "EXPORT_FINALIZE" 36;
  -- CP2's runtime binding resolution. A component asks the root which slot of
  -- its own CSpace holds a named binding, instead of compiling the number in
  -- from a `build.rs`-generated constant table (B70).
  --
  -- Self-scoped by badge on the same terms as the two `OCCUPANCY` operations:
  -- the request carries a binding *name* and no task argument, so there is no
  -- caller identity to forge. A name the caller was not granted answers
  -- `INVALID_ARG`, never another instance's slot.
  operation "capabilityTable" "RESOLVE_BINDING" 37;
  -- B70's fabric-graph read. A component asks the root for the declared
  -- participant rows of the graph its generation embeds, instead of compiling
  -- them in from `build.rs`'s `FABRIC_PARTICIPANTS`.
  --
  -- What a caller sees depends on who it is. The instance the graph names as
  -- its fabric component reads every row, because brokering is what it is
  -- declared to do: `FabricGraph` carries a `fabricComponentIdentity`, and the
  -- root already folds instance names to that identity to admit the graph at
  -- all (`fabric_graph_participants_are_declared`), so the test is a property
  -- of the generation rather than a policy judgement.
  --
  -- Every other instance reads two things and no more: its *own* rows, and the
  -- rows of components it shares a *declared capability edge* with. The first is
  -- the scoping `RESOLVE_BINDING` already applies -- a component learns what the
  -- generation declares about it. The second exists for a route worker, which
  -- brokers for participants it neither spawned nor holds the graph of, and
  -- discloses nothing new: the caller already holds an endpoint the root placed
  -- from the manifest, so it could already reach that component.
  --
  -- Deliberately not a general graph read. C8.8 makes *which routes exist* a
  -- filtered, per-caller answer the fabric enforces, and
  -- `just sel4_visibility_check` asserts an ungranted caller infers nothing; a
  -- caller that could enumerate the whole graph would bypass that gate rather
  -- than implement it. A component with no rows and no edges reads nothing, so
  -- neither scope discloses what its holder did not already have.
  --
  -- Cursor-paged, because one participant record is 128 bytes against a
  -- 64-byte message bound. The reply travels through the caller's transfer
  -- window like `directory`'s and `console`'s, bounded by
  -- `MAX_STAGED_ARRAY_BYTES`, so a call answers at most 8 rows and the caller
  -- resumes from the cursor it is returned.
  operation "capabilityTable" "GRAPH_READ" 38;
  -- The graph's index for a route the caller names by identity.
  --
  -- A participant knows its route by identity — it folds the route name, its
  -- interface identity, and the contract kind exactly as the builder does — but
  -- a participant row names the route by *index* into a table the resource
  -- sorts by that identity. Answering the fold here keeps the sort order inside
  -- the decoder that owns it; a component deriving the index locally would be
  -- assuming the resource's ordering, which is the coupling `GRAPH_READ`
  -- exists to remove.
  --
  -- Unscoped, and safe to answer for any caller: a route identity is something
  -- the asker already holds, so the answer confirms a fold it computed itself
  -- and names no route it did not already name.
  operation "capabilityTable" "GRAPH_ROUTE_INDEX" 39;
  -- B70's boot-action query: which composition the authenticated generation
  -- declares, as `BootAction`'s frozen numeric ABI.
  --
  -- Every fabric component branches on this to pick which plane's schedule to
  -- run (`== "traffic"`, `== "matrix"`). It is not graph data and not a
  -- binding: it is *which composition am I booted into*, a per-generation
  -- scalar. Until now the only way to know was a string compiled in from
  -- a per-plane profile private to `components/bins`'s single crate build
  -- script (CP3 has since hoisted that parser into
  -- `components/build-support`), which is exactly
  -- the coupling B70 names -- a component that cannot be built outside this
  -- crate because its behavior is selected at compile time by one manifest.
  --
  -- The root already holds the answer and already delivers it, but only to
  -- one instance: `main.rs` passes `boot_action.id()` as the bootstrap
  -- thread's first C parameter and zero to every other task, so the eleven
  -- participants that branch on it could not ask. This widens *who may ask*,
  -- not what is disclosed.
  --
  -- Unscoped, and that is the whole authority argument. A boot action is a
  -- property of the one generation every caller is already running inside, not
  -- of any instance within it, so there is no per-caller answer to leak and no
  -- identity to forge. It names no route, no component, no slot and no
  -- capability, so unlike `GRAPH_READ` it discloses no graph shape: a caller
  -- learns which composition it is part of, which its own declared behavior
  -- already depends on.
  --
  -- Being unscoped is why it is gated on the *lifecycle* service rather than
  -- the capability table this label's namespace names. The two are separate
  -- facts: the namespace groups the generated constants, the service is the
  -- authority the root demands before reading an argument. An operation
  -- answerable to every instance needs the service every instance declares,
  -- and `declared_services` gives an instance the capability-transfer service
  -- only for a spawn budget, an endpoint, or a transferable grant -- which 30
  -- of the 182 instances the seL4 fixtures declare do not hold. Every caller
  -- reads a refusal as "not this plane", so gating there would let an
  -- unrelated grant shape choose a component's schedule.
  --
  -- The *number* crosses, never the source spelling. `BootAction`'s ids are
  -- already a frozen ABI the bootstrap argument carries
  -- (`boot_action_numbering_is_frozen`), so answering with the same id keeps
  -- one encoding for both delivery paths rather than adding a second. It also
  -- keeps the answer in MR0 like every other scalar result, with no transfer
  -- window and no bytes to bound.
  operation "capabilityTable" "BOOT_ACTION" 40;
  -- B70's final fabric-profile cutover. The authenticated fabric-graph
  -- resource already carries its table cardinalities and every declared
  -- resource ceiling; this scalar query exposes those header facts without
  -- compiling the resource into a component. `field` is a generated
  -- `boot_contracts::fabric_graph::QUERY_*` id, so neither side carries a
  -- hand-written numbering table.
  --
  -- Graph shape remains holder-only. The generated `RuntimeLimits` subset is
  -- also available to a participant that can read at least one row through
  -- `GRAPH_READ`, because call/operation workers must admit traffic against
  -- the same authenticated limits while remaining independently buildable.
  -- A caller with no visible row, an unknown field id, and a graph-less
  -- generation are refused identically; identities, routes, grants, and slots
  -- remain behind `GRAPH_READ`, `GRAPH_ROUTE_INDEX`, and `RESOLVE_BINDING`.
  -- The capability-transfer service is the transport gate: every participant
  -- with a declared endpoint already receives it.
  operation "capabilityTable" "GRAPH_QUERY" 41;
  -- B70's command-profile cutover: the live-child budget this generation
  -- declares for the caller's own executable, as `spawnBudget`.
  --
  -- `spawn-service` admits one client request per live child and refuses a
  -- request whose `client_budget` field disagrees, and `dango` states that
  -- same number in every request it sends. Both read it from a table their
  -- build script parsed out of one generation manifest, so neither could be
  -- built against another -- the coupling B70 removes. It is not a binding and
  -- not graph data: it is a scalar the executable record already carries and
  -- the root already reads to bound `serve_spawn`, so the caller learns the
  -- ceiling it is about to be admitted against rather than anything new.
  --
  -- Self-scoped by badge, like the two `OCCUPANCY` operations: the request
  -- carries no operand, so there is no instance to name and nothing to forge.
  -- A caller cannot ask about another executable's budget, which is why this
  -- is a scalar query rather than a lookup by name -- a peer's budget is a
  -- property of the graph's shape, and `dango` needs only its own because the
  -- generation declares one budget for both ends of this protocol.
  --
  -- Gated on `spawn`, the service the root already demands before honouring a
  -- spawn at all. An instance the generation gives no spawn authority has no
  -- budget to report, and answering zero would be a number it could act on;
  -- the refusal says the question does not apply to it.
  operation "capabilityTable" "SPAWN_BUDGET" 42;
  -- C10.1's task-private memory growth. One operation, taking a signed page
  -- delta and answering the caller's *previous* page count, so an allocator
  -- learns where its region ended without a second call and a zero delta is a
  -- pure size query.
  --
  -- Not a capability operation, and that is the whole authority argument. The
  -- region this grows is one task-private window the root reserved in the
  -- caller's own VSpace at spawn: it is not nameable, transferable, loanable,
  -- sealable, or mappable by anyone else, so there is no object for a
  -- capability to designate and no identity to forge. What is bounded is how
  -- many pages a task may hold, which is a budget -- exactly as the stack is
  -- generation-sized and needs no capability. `docs/capability-matrix.md` is
  -- therefore unchanged: no seL4 object kind, no root-tracked object, and no
  -- right is added.
  --
  -- Self-scoped by badge, like the two `OCCUPANCY` operations and
  -- `SPAWN_BUDGET`: the request carries a delta and no task argument, so a
  -- caller can only grow its own region. Growth is all-or-nothing -- a failure
  -- part way through returns every frame the attempt took -- and the four
  -- refusals a caller must tell apart (delta overflow, reservation overrun,
  -- quota exhaustion, frame exhaustion) are distinguished by the root's own
  -- markers; the wire status stays the coarse class this contract already
  -- declares, so a component cannot map the root's internal predicates.
  --
  -- Gated on `lifecycle`, the one service every launched instance holds. A
  -- private heap is a property of being a task rather than of any grant, so
  -- gating it on a capability service would make a component's ability to
  -- allocate depend on an unrelated grant shape -- the same argument
  -- `BOOT_ACTION` records. A task the generation gives no quota is refused by
  -- its zero ceiling, which is a budget answer rather than an authority one.
  operation "lifecycle" "PRIVATE_MEMORY_GROW" 43;
  -- C9.1's generation-declared clock service. The caller identity comes from
  -- the badged root endpoint; no operation accepts a holder or notification
  -- argument. `MONOTONIC_READ` returns the current hardware counter. `TIMER_ARM`
  -- takes a relative counter-tick delay and returns an opaque timer id;
  -- `TIMER_CANCEL` consumes that id. `SIMULATED_READ` and
  -- `SIMULATED_ADVANCE` operate on the generation's deterministic test clock,
  -- which is independent from the hardware counter and advances only through
  -- the declared advance operation.
  --
  -- Authority is four independent bits in `clock-authority/v1`, not the
  -- lifecycle service and not a capability-table entry. An absent holder and
  -- a holder lacking the requested bit both answer `BAD_CAP`; malformed word
  -- counts answer `INVALID_ARG`, so denial and malformed requests are
  -- distinguishable. Timer expiry is delivered through the holder's declared
  -- generation Notification and badge, never through this reply channel.
  operation "clock" "MONOTONIC_READ" 44;
  operation "clock" "TIMER_ARM" 45;
  operation "clock" "TIMER_CANCEL" 46;
  operation "clock" "SIMULATED_READ" 47;
  operation "clock" "SIMULATED_ADVANCE" 48;
  -- The hardware counter's rate, so a holder can turn `MONOTONIC_READ` ticks
  -- and `TIMER_ARM` delays into durations. Ambient like `MONOTONIC_READ` since
  -- `clock-authority/v2`: knowing what a tick means grants nothing. The value
  -- is the root's own reading of the platform counter frequency, never a
  -- component-side table.
  operation "clock" "RATE_READ" 70;
  -- C9.2's declared wake sources. Self-scoped by badge exactly as
  -- `RESOLVE_BINDING` is: the request carries a cursor and a transfer
  -- descriptor, never a waiter, so a component reads its own source table and
  -- only its own. Each record is a `wait-set/v1` entry the caller decodes with
  -- `boot_contracts::wait_set`, in the contract's ascending-badge dispatch
  -- order, so the reply is the tie rule rather than merely its inputs.
  --
  -- Gated on `lifecycle`, the one service every launched instance holds, for the
  -- reason `BOOT_ACTION` and `PRIVATE_MEMORY_GROW` record: blocking on your own
  -- declared notification is a property of being a task, so gating it on a
  -- capability service would make whether a component can wait depend on an
  -- unrelated grant shape. A component the generation declares no sources for is
  -- answered zero records, which is the deny-by-default answer -- it has no
  -- source to register, and there is nothing about a peer for it to learn.
  operation "lifecycle" "WAIT_SOURCES" 49;
  -- C9.3's declared scheduling class. `CLASS_READ` is self-scoped by badge and
  -- returns the caller's own class id with its resolved priority beside it, so a
  -- component can observe what band it runs at without naming anyone.
  --
  -- `CLASS_PROMOTE` takes a supervision capability slot naming the subject and
  -- the requested class id. It names a *class*, never a priority: the priority
  -- comes from the generation's own band mapping, so a holder cannot reach a
  -- priority between two bands. Authority is the caller's declared
  -- `schedulingPromote` right plus a promotion edge the generation declares from
  -- this holder to that subject, bounded by the edge's own ceiling. A caller
  -- naming itself is refused before the edge lookup, because promotion is
  -- authority over *another* component's class and never over the holder's own.
  operation "scheduling" "CLASS_READ" 50;
  operation "scheduling" "CLASS_PROMOTE" 51;
  -- C9.4's lifecycle transitions and supervised restart. Five operations, split
  -- by what names the subject: two are self-scoped by badge, three name another
  -- component through a capability the generation grants.
  --
  -- `STATE_READ` is self-scoped and returns the caller's own lifecycle state
  -- with the declared restart attempts it has left beside it, so a component can
  -- observe whether it is a first launch or a replacement without naming anyone.
  -- Gated on `lifecycle` for `WAIT_SOURCES`' reason: which state a component is
  -- in is a property of being a task, not of any grant.
  --
  -- `STATE_ADVANCE` is self-scoped too, and it is the transition graph's only
  -- mutator. A component requests its *own* next state and the root refuses any
  -- edge the generation does not admit, so the graph is enforced rather than
  -- documented. A component cannot advance another's state at all: that would be
  -- lifecycle authority no C9.4 field grants.
  --
  -- `RESTART_ADMIT` takes a supervision capability slot naming the dead subject
  -- and returns whether the generation admits restarting it now: the declared
  -- attempt budget remaining, the terminal cause the root recorded, and the
  -- backoff instant before which a restart is refused. Authority is the caller's
  -- declared `lifecycleRestart` right on that handle. The root decides nothing
  -- about *whether* to restart -- it answers what the generation declares and
  -- refuses what it does not, and the supervisor holding the handle owns the
  -- decision and the spawn.
  --
  -- `PARAMETER_READ`/`PARAMETER_WRITE` take a supervision capability slot naming
  -- the subject plus a parameter key, and the write form a value. Authority is
  -- the caller's declared `parameterRead`/`parameterWrite` right *and* a
  -- parameter edge the generation declares from this holder to that subject. A
  -- caller holding no authority is refused `BAD_CAP`; a caller holding authority
  -- naming a key the subject has not set is answered `INVALID_ARG`, so absent
  -- authority and a missing key are distinguishable -- which is exactly C9.4's
  -- last required check.
  operation "lifecycle" "STATE_READ" 52;
  operation "lifecycle" "STATE_ADVANCE" 53;
  operation "supervision" "RESTART_ADMIT" 54;
  operation "supervision" "PARAMETER_READ" 55;
  operation "supervision" "PARAMETER_WRITE" 56;
  -- C9.5's declared recording participation. Self-scoped by badge exactly as
  -- `WAIT_SOURCES` is: the request carries no operand at all, so a component
  -- reads its own recording entry and only its own. The reply is three facts --
  -- the entry's role, the record capacity it may consume, and whether the
  -- generation claims it deterministic -- which is what a recorder needs to size
  -- its sink and a replayer needs to bound its input before it maps anything.
  --
  -- The declared *stream identity* is deliberately not among them. It is the
  -- generation's join key between two participants rather than a handle, so
  -- answering it would name a peer relationship the caller holds no capability
  -- over; the stream itself travels over the grant the generation declares for
  -- it, whose authority is that capability.
  --
  -- Gated on `lifecycle` for `WAIT_SOURCES`' reason, and the same deny-by-default
  -- shape: whether a component is *claimed* deterministic is a property of being
  -- that instance rather than of any grant, and an instance the resource does not
  -- name is answered a zero role rather than refused. That answer discloses
  -- nothing about a peer -- it says only "this generation declares no recording
  -- for me" -- and it is what makes a component able to run unchanged in a
  -- generation that records it and one that does not.
  --
  -- It grants nothing. The recording stream itself travels over a declared
  -- shared buffer between the two participants; this operation only reports what
  -- the generation already decided about the caller.
  operation "lifecycle" "RECORDING_SOURCES" 57;
  -- The caller's own declared lifetime, `instance-lifetime/v1`'s bounded (0)
  -- or resident (1). Self-scoped by badge with no operand, on
  -- `RECORDING_SOURCES`' terms: whether an instance is meant to outlive its
  -- clients is a property of being that instance, so it is gated on
  -- `lifecycle` and never refused for want of authority. A generation that
  -- declares no lifetime object answers bounded, which is what lets one image
  -- run resident in one composition and bounded in another.
  operation "lifecycle" "LIFETIME_READ" 73;
  -- IO4's authenticated exact-destination table, paged through the transfer
  -- window. The request names only a cursor; the root derives the caller from
  -- its badge and answers rows only when that instance is the declared network
  -- service. Destination matching and all protocol policy remain userspace.
  operation "capabilityTable" "NETWORK_DESTINATIONS_READ" 64;
  -- B83's authenticated per-ring block authority table, paged through the
  -- transfer window exactly as `NETWORK_DESTINATIONS_READ` is. The request
  -- names only a cursor; the root derives the caller from its badge and answers
  -- rows only when that instance is the generation's declared block driver.
  --
  -- The root reads no block right here and enforces none: it authenticates who
  -- may read the table and bounds the bytes. Deciding that a write on a
  -- read-only ring is refused is the driver's, because that is device policy.
  operation "capabilityTable" "BLOCK_RING_AUTHORITY_READ" 69;
  -- IO11's interface table, on `NETWORK_DESTINATIONS_READ`'s exact shape and
  -- identity gate: the root copies the authenticated `network-interface/v1`
  -- rows to the declared network service, which configures its own stack
  -- from its own row. The root learns no address.
  operation "capabilityTable" "NETWORK_INTERFACE_READ" 71;
  -- Authenticated application rows use the same reader identity and paging.
  -- The root copies bytes; binding names and protocol policy remain userspace.
  operation "capabilityTable" "NETWORK_APPLICATION_READ" 72;
  -- The authenticated `entropy-authority/v1` table, on
  -- `NETWORK_INTERFACE_READ`'s exact shape: the request names only a cursor,
  -- and the root copies rows only to the instance named `entropy-service`.
  -- The root draws no entropy and enforces no budget; both are the service's.
  operation "capabilityTable" "ENTROPY_AUTHORITY_READ" 74;
  -- The authenticated `zenoh-service-grants-table/v1` table, on
  -- `ENTROPY_AUTHORITY_READ`'s exact shape: the request names only a row
  -- cursor, and the root copies rows only to the instance named
  -- `zenoh-service`. No operand names a holder or a key.
  operation "capabilityTable" "ZENOH_GRANTS_READ" 75;
  -- IO1's root-brokered hardware-resource mechanism. Every object operand is a
  -- logical capability slot from the authenticated caller's own authority
  -- table; no task, driver, device, physical address, or interrupt number is
  -- accepted from application bytes.
  operation "ioResource" "BIND" 58;
  operation "ioResource" "MAP_MMIO" 59;
  operation "ioResource" "DMA_MAP" 60;
  operation "ioResource" "DMA_RELEASE" 61;
  operation "ioResource" "IRQ_ACK" 62;
  operation "ioResource" "QUEUE_MAP" 63;
  operation "ioResource" "REQUEST_BEGIN" 65;
  operation "ioResource" "REQUEST_SETTLE" 66;
  operation "ioResource" "MMIO_READ32" 67;
  operation "ioResource" "MMIO_WRITE32" 68;
};

-- The service namespaces, in the order the generated bindings emit them.
-- Declared rather than derived from `operations` so adding an operation cannot
-- silently reorder the emitted modules and churn the generated file.
--
-- `module` is the Rust module name both crates already spell out
-- (`lifecycle_labels::EXIT`). It is declared beside `name` rather than derived
-- from it: `capabilityTable` -> `capability_table` is a transform with no
-- inverse the renderer can check, so a renaming bug would be silent.
Service :: type { name : Text; module : Text; };

service :: Text -> Text -> Service = name module => { name = name; module = module; };

services :: List Service = {
  service "fixture" "fixture_labels";
  service "lifecycle" "lifecycle_labels";
  service "spawn" "spawn_labels";
  service "supervision" "supervision_labels";
  service "capabilityTable" "capability_table_labels";
  service "directory" "directory_labels";
  service "sharedBuffer" "shared_buffer_labels";
  service "capabilityTransfer" "capability_transfer_labels";
  service "clock" "clock_labels";
  service "scheduling" "scheduling_labels";
  service "ioResource" "io_resource_labels";
};

-- The status a root service returns in reply MR0. Deliberately coarse: a
-- component learns that its request failed and in which class, not which
-- internal predicate rejected it. Several distinct root-side conditions
-- therefore share a code, and that collapsing is a decision this contract
-- records rather than a coincidence of the mapping.
Status :: type { name : Text; code : Int; };

status :: Text -> Int -> Status = name code => { name = name; code = code; };

statuses :: List Status = {
  status "SUCCESS" 0;
  status "BAD_CAP" 1;
  status "PEER_DEAD" 2;
  status "WOULDBLOCK" 3;
  status "INVALID_ARG" 4;
  status "OUT_OF_MEMORY" 5;
};

-- Bounds of the root-service message envelope. `MAX_MSG` is the payload a
-- single request may carry; `MAX_CAPS_PER_MSG` is the native capability count a
-- message may transfer.
maxMessageBytes :: Int = 64;
maxMessageCaps :: Int = 1;

-- A spawn-grant record as staged in the transfer window: the child slot the
-- grant addresses, then its rights mask. Both are 8 bytes little-endian, so a
-- record is 16. This layout was previously the constant `GRANT_RECORD_BYTES` in
-- the userspace transport and `SPAWN_GRANT_RECORD_BYTES` in the root, kept in
-- agreement by a doc comment reading "Matches ...".
grantRecordBytes :: Int = 16;
grantSlotOffset :: Int = 0;
grantRightsOffset :: Int = 8;

abi ::= {
  formatVersion =; operations =; services =; statuses =;
  maxMessageBytes =; maxMessageCaps =;
  grantRecordBytes =; grantSlotOffset =; grantRightsOffset =;
};

main :: { write : FsWrite; env : Env; } -> Unit ! { * fs.WholeWriteEffects; * env.GetEffects; }
  = caps => [
    root := env.get caps.env "SLIME_SYSCALL_ABI_BINDINGS_ROOT" ?? ".";
    bindings := gen.render abi;
    fs.writeAll caps.write (t.join "" { root; "/syscall_abi.rs"; }) bindings.rust;
    fs.writeAll caps.write (t.join "" { root; "/syscall_abi.h"; }) bindings.c;
    fs.writeAll caps.write (t.join "" { root; "/syscall-abi.md"; }) bindings.markdown
  ];
main
