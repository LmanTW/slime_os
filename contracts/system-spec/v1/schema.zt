-- Slime OS system specification contract, version 1 (CP1).
--
-- A `SystemSpec` is one composition: which components a generation admits, the
-- authority edges between them, and the graph they exchange data over. It is
-- the system-level half of the model `contracts/component-spec/v1` began —
-- a component spec describes a component, a system spec composes instances of
-- them into a generation.
--
-- The point is that `contracts/generation-manifest/v1`'s `executables`, `instances`,
-- `objects`, `sharedBufferBudget`, and `health.requiredInstances` sections stop
-- being hand-authored: `scripts/generate/generate-generation-from-spec.py`
-- derives them from this record plus the referenced component specs. What
-- remains declared here is what genuinely cannot be derived — a component
-- spec describes a component in isolation and cannot know which *other*
-- components a particular system grants it authority over.
--
-- This is not a wire format. Nothing serializes a `SystemSpec`; the generation
-- manifest it produces is what the builder encodes, and
-- `contracts/generation-manifest/v1` still owns that boundary.

privatePolicy ::= import private_policy.declarations;

-- One authority edge. Identical in shape to `contracts/generation-manifest/v1`'s
-- `CapabilityGrant`, because it *is* that record: the generator copies it
-- through rather than translating, so there is no second grant vocabulary to
-- keep in step.
--
-- Grants are the irreducible system-level fact. Which components exist is a
-- list of component specs; which of them may talk to which is only ever a
-- property of the composition, so it is declared, and every instance binding is
-- then derived from it.
SystemGrant :: type {
  name : Text;
  capabilityKind : Text;
  source : Text;
  target : Text;
  rights : List Text;
  transferable : Bool;
};

-- One statically created notification, as `contracts/generation-manifest/v1`'s
-- `NotificationGrant`. Stream rings declare two — ready flows producer to
-- consumer, credit flows back — but not every stream participant gets a ring
-- (`fabric-observer` has none), so the set is declared rather than derived from
-- the route table.
SystemNotification :: type {
  name : Text;
  source : Text;
  target : Text;
};

-- One holder's view of a notification, as `NotificationBinding`. `slot` is
-- optional on the same terms the generation manifest gives it: omitted asks the
-- builder to assign deterministically, present pins a byte-frozen layout.
SystemNotificationBinding :: type {
  grant : Text;
  holder : Text;
  slot? : Int;
  role : Text;
};

-- One pinned capability slot.
--
-- Bindings are derived from `grants`, so their slot numbers would ordinarily be
-- assigned by `build-generation.py::assign_declared_slots` — the lowest free
-- number per holder, in grant-name order. That is exactly what
-- `sel4-channel.zti` already encodes, and it needs no pins at all. `valid.zti`
-- does: 44 of its 76 bindings sit at hand-picked numbers because
-- `contracts/boot-layout/v1/fixtures/*.layout` freeze them byte for byte, and
-- `components/build-support/src/lib.rs` reads several of them out of the
-- manifest text.
--
-- Three of those 44 exist for a subtler reason worth stating, because a reviewer
-- caught it and the gate did not: dropping the four bindings that name no grant
-- freed the slots they occupied, and `assign_declared_slots` then handed those
-- numbers to the next binding in grant-name order, silently moving
-- `generation-manager`'s rollback/select/stage bindings from 2/3/4 to 1/2/3.
-- Pinning them holds the pre-CP1 layout, and the gate now resolves the frozen
-- baseline independently so no future removal can renumber a live slot unnoticed.
--
-- A pin is therefore a real, narrow exception rather than the normal case: it
-- says "this number is load-bearing elsewhere", and the generator refuses a pin
-- naming a (holder, grant) pair the grant table does not produce, so a stale
-- pin cannot silently do nothing.
--
-- `reason` says *which* of those things holds, in the closed
-- `generation-manifest` `InstanceBinding.slotReason` vocabulary, and is carried
-- through to the derived binding unchanged (B91). It is declared here rather
-- than inferred at derivation time for the same reason the pin itself is: the
-- derived manifest is compared against a frozen baseline, so a claim about why
-- a number is fixed belongs in the reviewed source, where changing it is a
-- visible edit. The generation builder then re-derives the expected value from
-- the manifest and refuses a pin whose stated reason it cannot confirm, so a
-- wrong label here fails a gate instead of documenting a fiction.
SlotPin :: type {
  holder : Text;
  grant : Text;
  slot : Int;
  reason : Text;
};

-- Which executables one component may spawn by command name.
--
-- Not derivable from the exec grants alone: `dango` spawns `echo-agent` through
-- the command name `echo`, so the mapping from command to executable is a
-- composition choice, not a property of either component.
CommandBinding :: type {
  component : Text;
  commands : List Text;
};

-- Per-component generation-module image size.
--
-- Declared with one default and explicit exceptions rather than per component,
-- because it is uniform for all but a handful. `Object.size` is presently
-- carried by the manifest and read by nothing — no builder path, no Rust
-- decoder — so this exists to reproduce the declared field faithfully, not
-- because a number here changes an admitted image.
ImageSize :: type {
  component : Text;
  bytes : Int;
};

-- One persisted state binding, as `contracts/generation-manifest/v1`'s `StateBinding`.
-- Which state a component owns is arguably a component fact, but its schema
-- version and retention policy are what *this* system admits, so the whole
-- record is declared here rather than split across two contracts.
SystemState :: type {
  name : Text;
  owner : Text;
  schemaVersion : Int;
  policy : Text;
};

-- QoS and route shape are `contracts/generation-manifest/v1`'s `FabricParticipant` and
-- `FabricRoute`, reproduced field for field. CP1 deliberately does not define a
-- second graph representation: the generator copies these records into the
-- manifest's `fabricGraph`, so the fabric contract has exactly one shape and
-- `contracts/component-spec/v1`'s QoS entries are checked against it.
SystemParticipant :: type {
  component : Text;
  direction : Text;
  visibility : Text;
  interposition : List Text;
  reliability : Text;
  durability : Text;
  liveliness : Text;
  historyDepth : Int;
  retainedDepth : Int;
  deadlineNs : Int;
  lifespanNs : Int;
  leaseNs : Int;
};

SystemRoute :: type {
  name : Text;
  interface : Text;
  participants : List SystemParticipant;
};

SystemFabricLimits :: type {
  routes : Int;
  ingressSources : Int;
  publishers : Int;
  subscribers : Int;
  clients : Int;
  servers : Int;
  sampleBytes : Int;
  queueDepth : Int;
  historyDepth : Int;
  eventDepth : Int;
  retainedSamples : Int;
  retries : Int;
  inFlightCalls : Int;
  inFlightOperations : Int;
  bufferPages : Int;
  mappings : Int;
  loans : Int;
  capabilitySlots : Int;
  buffers : Int;
};

SystemProfileInterposition :: type {
  route : Text;
  participant : Text;
  chain : List Text;
};

SystemFabricProfile :: type {
  name : Text;
  interpositions : List SystemProfileInterposition;
  streamControls : List Text;
};

SystemFabricGraph :: type {
  fabricComponent : Text;
  limits : SystemFabricLimits;
  traceDepth : Int;
  traceOverflow : Text;
  routes : List SystemRoute;
  profiles : List SystemFabricProfile;
};

-- One named boot composition, as `contracts/generation-manifest/v1`'s `BootProfile`.
SystemBootProfile :: type {
  name : Text;
  fabricProfile : Text;
  instances : List Text;
  requiredInstances : List Text;
};

-- C9.1 root-brokered clock service authority, as `contracts/generation-manifest/v1`'s
-- `ClockAuthorityEntry`, reproduced field for field: neither list nor grant table
-- can derive who reads simulated time or holds a timer quota, so it is declared.
-- Reading the monotonic clock is ambient (`clock-authority/v2`).
SystemClockAuthority :: type {
  holder : Text;
  timerUse : Bool;
  simulatedRead : Bool;
  simulatedAdvance : Bool;
  timerQuota : Int;
  timerNotification? : Text;
  timerBadgeBit? : Int;
};

-- IO1 per-driver hardware-resource ceilings, as `IoResourceBudgetEntry`.
SystemIoResourceBudget :: type {
  holder : Text;
  mmioBytes : Int;
  mmioMappings : Int;
  dmaPages : Int;
  dmaMappings : Int;
  irqSources : Int;
  outstandingRequests : Int;
  bufferLoans : Int;
  device? : Int;
};

-- IO4 exact network-destination authority, as `NetworkDestinationEntry`.
SystemNetworkDestination :: type {
  holder : Text;
  transport : Text;
  addressKind : Text;
  address : Text;
  port : Int;
  rights : List Text;
  queueDepth : Int;
  byteBudget : Int;
  timerBudget : Int;
  retryLimit : Int;
  reconnectLimit : Int;
  socketLimit : Int;
  listenerLimit : Int;
  dnsRecordLimit : Int;
};

-- IO11 static interface declaration, as `NetworkInterfaceEntry`. Optional at
-- the spec level so the specs that predate it need no row.
SystemNetworkInterface :: type {
  holder : Text;
  address : Text;
  prefixLen : Int;
  gateway : Text;
  mac : Text;
};

-- Entropy authority row, as `EntropyAuthorityEntry`. `source` is "hardware"
-- or "seeded"; only a seeded row carries `seed`, 64 lowercase hex digits.
-- Optional at the spec level so the specs that predate it need no row.
SystemEntropyAuthority :: type {
  holder : Text;
  source : Text;
  byteBudget : Int;
  seed? : Text;
};

-- Zenoh service grant row, as `ZenohGrantEntry`. Optional at the spec level so
-- the specs that predate it need no row.
SystemZenohGrant :: type {
  holder : Text;
  key : Text;
  publish : Bool;
  subscribe : Bool;
};

-- Application bindings and exact local listener policy, distinct from remote destinations.
SystemNetworkApplication :: type {
  holder : Text;
  controlBinding : Text;
  provisionBinding : Text;
  supervisionBinding : Text;
  requestNotification : Text;
  completionNotification : Text;
  role : Text;
  backend : Text;
  localAddress : Text;
  localPort : Int;
  admittedPeer : Text;
  admittedPeerAddress : Text;
  rights : List Text;
  backlog : Int;
  acceptedSocketLimit : Int;
  byteBudget : Int;
  timerBudget : Int;
  queueDepth : Int;
  retryLimit : Int;
  reconnectLimit : Int;
  -- network-application/v3 TCP options for every socket the row opens or accepts.
  keepaliveMs : Int;
  idleTimeoutMs : Int;
  hopLimit : Int;
  nagle : Bool;
  -- network-application/v4 buffer sizes for every socket the row opens or accepts.
  rxBufferBytes : Int;
  txBufferBytes : Int;
};

-- B83 exact per-ring block authority, as `BlockRingAuthorityEntry`.
SystemBlockRingAuthority :: type {
  holder : Text;
  device : Int;
  ring : Int;
  rights : List Text;
  sectorLimit : Int;
};

-- C9.2 wait-set source table, as `WaitSetSourceEntry`.
SystemWaitSetSource :: type {
  waiter : Text;
  notification : Text;
  badgeBit : Int;
  kind : Text;
  drainSlot? : Int;
};

-- C9.3 scheduling-class policy, as `SchedulingClassBand`/`SchedulingClassEntry`/
-- `SchedulingPromotionEntry`/`SchedulingClassPolicy` together, because none of
-- the three is meaningful without the other two.
SystemSchedulingClassBand :: type {
  class : Text;
  priority : Int;
};

SystemSchedulingClassEntry :: type {
  instance : Text;
  class : Text;
  workerClass? : Text;
};

SystemSchedulingPromotion :: type {
  holder : Text;
  subject : Text;
  ceiling : Text;
};

SystemSchedulingClassPolicy :: type {
  bands : List SystemSchedulingClassBand;
  instances : List SystemSchedulingClassEntry;
  promotions : List SystemSchedulingPromotion;
};

-- C9.4 lifecycle policy, as `LifecycleTransition`/`LifecycleRestartPolicy`/
-- `LifecycleHealthDependency`/`LifecycleParameterGrant`/`LifecyclePolicy`.
SystemLifecycleTransition :: type {
  from : Text;
  to : Text;
};

SystemLifecycleRestart :: type {
  instance : Text;
  attempts : Int;
  causes : List Text;
  backoffNs : Int;
  backoffFactor? : Int;
};

SystemLifecycleHealthDependency :: type {
  instance : Text;
  dependency : Text;
  requiredState : Text;
};

SystemLifecycleParameterGrant :: type {
  holder : Text;
  subject : Text;
  read : Bool;
  write : Bool;
};

SystemLifecyclePolicy :: type {
  initialState : Text;
  terminalState : Text;
  transitions : List SystemLifecycleTransition;
  restarts : List SystemLifecycleRestart;
  dependencies : List SystemLifecycleHealthDependency;
  parameters : List SystemLifecycleParameterGrant;
};

-- C9.5 recording-stream participation, as `RecordingEntry`.
SystemRecordingEntry :: type {
  instance : Text;
  stream : Text;
  streamGrant? : Text;
  role : Text;
  deterministic : Bool;
  recordCapacity : Int;
};

-- One instance's placement facts that belong to the composition rather than to
-- the component.
--
-- `owner` is here and not in the component spec because the same component can
-- be owned by `root` in one system and by a spawner in another — `console` is
-- owned by `root` in `valid.zti` and by `init` in `sel4-channel.zti`. The
-- component spec's `owner` records what the reference generation does; a
-- placement overrides it when a system composes the component differently.
--
-- `autostart` defaults to true, which every instance in every current fixture
-- declares.
--
-- `spawnBudget` is here too, and its being a placement rather than a component
-- fact is a finding of this milestone rather than a preference: `init` carries
-- 1 in `sel4-channel.zti`, 2 in `sel4-crossing.zti`, 18 in `valid.zti`, and 19
-- in `sel4-boot.zti`; the retired Dango composition historically carried 4.
-- A spawn budget is how many children *this* composition launches, so a
-- component spec cannot own it. The component spec's
-- `runtime.resource.spawnBudget` remains the reference
-- generation's value and is the default when a system declares no placement.
-- `lifetime` overrides the component spec's default on the same terms: a
-- composition that keeps a service up for the life of its graph declares it
-- `resident`, where another composition runs the same component `bounded`.
-- `health` overrides the component spec's own default the same way `owner`
-- does: `supervision-child` is `required` composed alone under
-- `sel4-supervision.zti` and `optional` composed alongside the reclamation
-- loop under `sel4-reclamation.zti`, so which is true is a fact of the
-- composition, not of the component.
-- `role` overrides `componentType` the same way: `slisp` is the reference
-- generation's `application`, spawned by `init`, but `sel4-slisp.zti` runs it
-- as its own bootstrap — a role that changes with the composition, not with
-- the component.
-- `dependencies` overrides the component spec's own activation barrier for the
-- same reason: `slisp` depends on `console` in the reference generation that
-- composes both, and on nothing at all in `sel4-slisp.zti`, which admits only
-- `slisp`. A dependency names a concrete instance in *this* graph, so a
-- composition that admits a different set owns its own answer.
-- `stackBytes` is a placement for the same reason `spawnBudget` is: the
-- reference generation's stack is the component spec's, but a composition can
-- run the same component with a larger one — `sel4.zti` gives one executable
-- 65536 where its spec declares the 16384 default.
-- The four shared-buffer ceilings and `privatePageQuota` are placements on the
-- same terms. A quota is how much of a *composition's* budget one instance may
-- hold, and the corpus disagrees per plane: `fabric-call-client` holds one
-- buffer and one loan in the reference generation and two of each under
-- `sel4-call.zti`. The component spec's numbers stay the reference
-- generation's, and a system that composes the component differently declares
-- its own. Absent means the component spec's value, so a plane that changes
-- nothing declares nothing.
-- `executableName` renames the emitted executable when a composition's own
-- executable identity differs from the component spec that describes it. The
-- corpus's convention is that a `sel4-`-prefixed binary implements the
-- unprefixed spec identity — `generation-manager` names
-- `sel4-generation-manager`, `filesystem-service` names
-- `sel4-filesystem-service` — and two compositions name the *binary* rather
-- than the spec in their `Executable.name` and `Instance.executable` fields.
-- Only one spec may claim one implementation binary, so a second spec under
-- the binary's own name is not available; the composition states the emitted
-- name instead. Absent means the component's own name, which every other
-- composition uses.
Placement :: type {
  component : Text;
  executableName? : Text;
  owner? : Text;
  autostart? : Bool;
  health? : Text;
  lifetime? : Text;
  role? : Text;
  dependencies? : List Text;
  spawnBudget? : Int;
  stackBytes? : Int;
  bufferBytePages? : Int;
  bufferCount? : Int;
  mappingCount? : Int;
  loanCount? : Int;
  privatePageQuota? : Int;
  priority? : Int;
  extraThreads? : Int;
  workerPriority? : Int;
};

-- One concrete instance, when a composition needs to say more than "one
-- instance per admitted component, named for it".
--
-- That default is what CP1 assumed and what 22 compositions satisfy, but it is
-- not general: `contracts/generation-manifest/v1`'s `Instance.executable` has
-- always been a separate field from `Instance.name`, and the corpus uses it.
-- `clock-authority-probe` runs as five instances — `clock-monotonic`,
-- `clock-timer`, `clock-simulated-reader`, `clock-simulated-advancer`,
-- `clock-denied` — each granted different clock authority, and
-- `supervision-child` runs as 26. One executable, many instances, and the
-- authority tables key on the *instance*, so the instance is the thing a
-- composition must be able to name.
--
-- `executable` names an admitted component; several instances may share one.
-- The override fields are the instance-level half of `Placement`: `owner`,
-- `autostart`, `health`, `dependencies`, the thread/priority fields, and the
-- five quotas are per instance, while `role`, `spawnBudget`, and `stackBytes`
-- stay on `Placement` because the manifest carries them on `Executable`, which
-- is one record per distinct binary however many instances run it.
--
-- `dependencies` matters most here: it names concrete instances in this graph,
-- and a multi-instance composition routinely has one instance depend on
-- another running the same executable (`lifecycle-worker` on
-- `lifecycle-supervisor`). No component spec can state that.
--
-- An empty `instances` list means the default: one instance per admitted
-- component, named for it, taking its `Placement`. A composition that declares
-- instances declares all of them.
SystemInstance :: type {
  name : Text;
  executable : Text;
  owner? : Text;
  autostart? : Bool;
  health? : Text;
  lifetime? : Text;
  dependencies? : List Text;
  bufferBytePages? : Int;
  bufferCount? : Int;
  mappingCount? : Int;
  loanCount? : Int;
  privatePageQuota? : Int;
  priority? : Int;
  extraThreads? : Int;
  workerPriority? : Int;
};

-- One binding a composition establishes beyond the grant table's own
-- structural rule: a holder that is neither the grant's source nor its target.
--
-- A spawn broker is the case that requires it. `sel4.zti` gives
-- `spawn-service` bindings on `spawn-service-echo` and
-- `spawn-service-sysinfo`, two `executable` grants issued by `init` and
-- targeting `echo-agent` and `sysinfo`; the broker holds the spawn authority
-- so that `dango` can reach those commands through it. Which grants a broker
-- carries cannot be derived: a command name is not an executable name (the
-- `echo` command runs `echo-agent`), so the mapping is a composition choice,
-- and unlike `slotPins` these bindings need no pinned number, so the pin table
-- cannot carry them either.
ExtraBinding :: type {
  holder : Text;
  grant : Text;
};

-- One capability an owner mints at runtime and hands to an instance it owns at
-- spawn, as `contracts/generation-manifest/v1`'s `MintedBinding`.
--
-- Declared rather than derived for the reason that record exists at all: a
-- channel endpoint minted after activation has no object for a grant to name,
-- so who mints it, who receives it, and the exact rights ceiling are
-- composition facts with nothing in the grant table to imply them. `slot` is
-- optional on the same terms every other binding's is.
SystemMintedBinding :: type {
  name : Text;
  owner : Text;
  holder : Text;
  capabilityKind : Text;
  slot? : Int;
  rights : List Text;
  transferable : Bool;
};

-- `deploymentConstraint` and `acceptanceCriteria` are the requirement
-- document's §4.2 fields, kept as bounded declared text: a deployment
-- constraint this repository can *enforce* is already expressed as a target
-- profile or a resource bound, so these record the human-level statement the
-- system is accepted against rather than inventing a second enforcement path
-- that nothing reads.
SystemSpec :: type {
  formatVersion : Int;
  name : Text;
  generation : Int;
  -- A `contracts/target-profile/v1` profile name, becoming the manifest's
  -- `target`. It is deliberately *not* required to equal the referenced
  -- component specs' `runtime.executionEnvironment`: the same components
  -- compose into both `valid.zti` (x86_64-qemu-virtio) and `sel4-channel.zti`
  -- (aarch64-sel4-qemu-virt), so a component spec's environment records the
  -- reference generation it was authored against rather than an exclusive
  -- claim. Per-image target qualification belongs to immutable selector/root
  -- admission through `contracts/component/v2`'s header and is gated there.
  targetRequirement : Text;
  bootAction : Text;
  bootstrapInstance : Text;
  bootAttempts : Int;
  components : List Text;
  placements : List Placement;
  instances : List SystemInstance;
  grants : List SystemGrant;
  slotPins : List SlotPin;
  extraBindings : List ExtraBinding;
  mintedBindings : List SystemMintedBinding;
  commandBindings : List CommandBinding;
  defaultImageBytes : Int;
  imageSizes : List ImageSize;
  -- Whether the generation carries a `shared-buffer-budget` resource object.
  --
  -- Declared rather than derived from "does any component have a budget",
  -- because the two are genuinely independent in the builder: the object's
  -- presence is what makes it *encode* a budget payload
  -- (`build-generation.py` line 3866), and the current fixtures disagree about
  -- the correlation — `sel4-channel` and `sel4-crossing` carry the object with
  -- an empty budget, while `sel4-directory` and `sel4-filesystem` carry neither.
  -- Deriving it would silently change which payloads four existing generations
  -- encode. The `fabric-graph` object needs no such field: the builder already
  -- refuses a graph without the object and an object without the graph, so its
  -- presence *is* derived.
  sharedBufferBudgetObject : Bool;
  -- Whether the generation carries a `boot-layout` resource object.
  --
  -- Every composition but one does, and that one is why this is declared:
  -- `sel4-stress.zti` carries no boot layout at all. Its graph is `init` plus
  -- 22 instances of one child spawned by name, so nothing reads a layout row,
  -- and asserting the object universally would add a payload that generation
  -- has never encoded.
  bootLayoutObject : Bool;
  interfaceSchemas : List Text;
  state : List SystemState;
  notifications : List SystemNotification;
  notificationBindings : List SystemNotificationBinding;
  bootProfiles : List SystemBootProfile;
  fabricGraph? : SystemFabricGraph;
  -- Explicit v2 policy conflicts with every effective fixed privatePageQuota.
  privateMemoryPolicy? : privatePolicy.Policy;
  -- The eight remaining generation-manifest sections that name concrete
  -- authority or policy independent of any component spec, on the same terms
  -- `notifications`/`fabricGraph` are: no component in isolation can state who
  -- reads a clock, drives an IO1 device, owns a block ring, reaches a network
  -- destination, wakes on a wait-set source, runs at a scheduling class,
  -- transitions a lifecycle graph, or records a stream, because each is a
  -- property of what this composition grants, not of the component alone.
  --
  -- Each carries a companion `*Object` boolean, mirroring
  -- `sharedBufferBudgetObject`: builder object presence and declared-list
  -- non-emptiness are independent facts in the existing corpus (B83's
  -- `sel4-io-network` carries a `wait-set` resource object with no declared
  -- source), so presence cannot be derived from the list alone.
  clockAuthority : List SystemClockAuthority;
  clockAuthorityObject : Bool;
  ioResourceBudget : List SystemIoResourceBudget;
  ioResourceBudgetObject : Bool;
  networkDestinations : List SystemNetworkDestination;
  networkDestinationsObject : Bool;
  networkInterfaces? : List SystemNetworkInterface;
  networkInterfacesObject? : Bool;
  networkApplications? : List SystemNetworkApplication;
  networkApplicationsObject? : Bool;
  entropyAuthority? : List SystemEntropyAuthority;
  entropyAuthorityObject? : Bool;
  zenohGrants? : List SystemZenohGrant;
  zenohGrantsObject? : Bool;
  blockRingAuthority : List SystemBlockRingAuthority;
  blockRingAuthorityObject : Bool;
  waitSet : List SystemWaitSetSource;
  waitSetObject : Bool;
  schedulingClass? : SystemSchedulingClassPolicy;
  lifecyclePolicy? : SystemLifecyclePolicy;
  recording : List SystemRecordingEntry;
  recordingObject : Bool;
  deploymentConstraint : Text;
  acceptanceCriteria : Text;
};

FromData @SystemClockAuthority :: derive
FromData @SystemIoResourceBudget :: derive
FromData @SystemNetworkDestination :: derive
FromData @SystemNetworkInterface :: derive
FromData @SystemNetworkApplication :: derive
FromData @SystemEntropyAuthority :: derive
FromData @SystemZenohGrant :: derive
FromData @SystemBlockRingAuthority :: derive
FromData @SystemWaitSetSource :: derive
FromData @SystemSchedulingClassBand :: derive
FromData @SystemSchedulingClassEntry :: derive
FromData @SystemSchedulingPromotion :: derive
FromData @SystemSchedulingClassPolicy :: derive
FromData @SystemLifecycleTransition :: derive
FromData @SystemLifecycleRestart :: derive
FromData @SystemLifecycleHealthDependency :: derive
FromData @SystemLifecycleParameterGrant :: derive
FromData @SystemLifecyclePolicy :: derive
FromData @SystemRecordingEntry :: derive

FromData @SystemGrant :: derive
FromData @SystemNotification :: derive
FromData @SystemNotificationBinding :: derive
FromData @SlotPin :: derive
FromData @CommandBinding :: derive
FromData @ImageSize :: derive
FromData @SystemState :: derive
FromData @SystemParticipant :: derive
FromData @SystemRoute :: derive
FromData @SystemFabricLimits :: derive
FromData @SystemProfileInterposition :: derive
FromData @SystemFabricProfile :: derive
FromData @SystemFabricGraph :: derive
FromData @SystemBootProfile :: derive
FromData @Placement :: derive
FromData @SystemInstance :: derive
FromData @ExtraBinding :: derive
FromData @SystemMintedBinding :: derive
FromData @SystemSpec :: derive

formatVersion :: Int = 1;
identityDomain :: Text = "slime-system-spec-v1:";

-- Bounds. `maxComponents` is `contracts/generation-manifest/v1`'s admitted-instance
-- ceiling; the rest mirror the manifest limits the builder already enforces, so
-- a system spec cannot describe a generation the builder would refuse.
maxComponents :: Int = 48;
maxInstances :: Int = 64;
maxSourceBytes :: Int = 262144;
maxNameBytes :: Int = 64;
maxTextBytes :: Int = 256;
maxGrants :: Int = 128;
maxSlotPins :: Int = 128;
