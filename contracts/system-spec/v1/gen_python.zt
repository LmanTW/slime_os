-- Generated host constants for the CP1 system-spec compiler.
--
-- `scripts/lib/system_spec.py` consumes these rather than restating the bounds
-- `schema.zt` declares, on the same terms `contracts/component-spec/v1` does.

schema ::= import "schema.zt";
env ::= import stdlib.env;
fs ::= import stdlib.fs;
n ::= import stdlib.num;
t ::= import stdlib.text;

line :: Text -> Int -> Text
  = name value => t.join "" { name; " = "; n.toText value; "\n"; };

render :: Text = t.join "" {
  "# @generated by contracts/system-spec/v1/gen_python.zt; do not edit.\n";
  line "FORMAT_VERSION" schema.formatVersion;
  "IDENTITY_DOMAIN = "; t.show schema.identityDomain; ".encode(\"utf-8\")\n";
  line "MAX_COMPONENTS" schema.maxComponents;
  line "MAX_INSTANCES" schema.maxInstances;
  line "MAX_SOURCE_BYTES" schema.maxSourceBytes;
  line "MAX_NAME_BYTES" schema.maxNameBytes;
  line "MAX_TEXT_BYTES" schema.maxTextBytes;
  line "MAX_GRANTS" schema.maxGrants;
  line "MAX_SLOT_PINS" schema.maxSlotPins;
  line "MAX_EXTRA_BINDINGS" schema.maxExtraBindings;
  line "MAX_MINTED_BINDINGS" schema.maxMintedBindings;
  line "MAX_NOTIFICATIONS" schema.maxNotifications;
  line "MAX_NOTIFICATION_BINDINGS" schema.maxNotificationBindings;
  line "MAX_BOOT_PROFILES" schema.maxBootProfiles;
  line "MAX_ROUTES" schema.maxRoutes;
  line "MAX_PARTICIPANTS_PER_ROUTE" schema.maxParticipantsPerRoute;
  line "MAX_PROFILES" schema.maxProfiles;
  line "MAX_STATE_BINDINGS" schema.maxStateBindings;
  line "MAX_INTERFACE_SCHEMAS" schema.maxInterfaceSchemas;
  line "MAX_COMMAND_BINDINGS" schema.maxCommandBindings;
  line "MAX_IMAGE_SIZES" schema.maxImageSizes;
  line "MAX_CLOCK_AUTHORITY" schema.maxClockAuthority;
  line "MAX_IO_RESOURCE_BUDGET" schema.maxIoResourceBudget;
  line "MAX_NETWORK_DESTINATIONS" schema.maxNetworkDestinations;
  line "MAX_NETWORK_INTERFACES" schema.maxNetworkInterfaces;
  line "MAX_NETWORK_APPLICATIONS" schema.maxNetworkApplications;
  line "MAX_ENTROPY_AUTHORITY" schema.maxEntropyAuthority;
  line "MAX_ZENOH_GRANTS" schema.maxZenohGrants;
  line "MAX_BLOCK_RING_AUTHORITY" schema.maxBlockRingAuthority;
  line "MAX_WAIT_SET_SOURCES" schema.maxWaitSetSources;
  line "MAX_SCHEDULING_CLASS_BANDS" schema.maxSchedulingClassBands;
  line "MAX_SCHEDULING_CLASS_ENTRIES" schema.maxSchedulingClassEntries;
  line "MAX_SCHEDULING_PROMOTIONS" schema.maxSchedulingPromotions;
  line "MAX_LIFECYCLE_TRANSITIONS" schema.maxLifecycleTransitions;
  line "MAX_LIFECYCLE_RESTARTS" schema.maxLifecycleRestarts;
  line "MAX_LIFECYCLE_HEALTH_DEPENDENCIES" schema.maxLifecycleHealthDependencies;
  line "MAX_LIFECYCLE_PARAMETER_GRANTS" schema.maxLifecycleParameterGrants;
  line "MAX_RECORDING_ENTRIES" schema.maxRecordingEntries;
};

main :: { write : FsWrite; env : Env; }
  -> Unit ! { * fs.WholeWriteEffects; * env.GetEffects; }
  = caps => [
    root := env.get caps.env "SLIME_SYSTEM_SPEC_BINDINGS_ROOT" ?? ".";
    path := t.join "" { root; "/system_spec_contract.py"; };
    fs.writeAll caps.write path render
  ];

main
