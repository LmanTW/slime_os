schema ::= import "schema.zt";
env ::= import stdlib.env;
fs ::= import stdlib.fs;
n ::= import stdlib.num;
t ::= import stdlib.text;

line :: Text -> Int -> Text
= name value => t.join "" { name; " = "; n.toText value; "\n"; };

text :: Text -> Text -> Text
= name value => t.join "" { name; " = \""; value; "\"\n"; };

render :: Text = t.join "" {
  "# @generated by contracts/image-attestation/v1/gen_python.zt; do not edit.\n";
  line "FORMAT_VERSION" schema.formatVersion;
  text "NOTES_REF" schema.notesRef;
  line "COMMIT_BYTES" schema.commitBytes;
  line "DIGEST_BYTES" schema.digestBytes;
  line "MAX_NAME_BYTES" schema.maxNameBytes;
  line "MAX_IMAGES" schema.maxImages;
  line "MAX_HOST_CLASS_BYTES" schema.maxHostClassBytes;
  line "MAX_RUNNER_BYTES" schema.maxRunnerBytes;
};

main :: { write : FsWrite; env : Env; }
-> Unit ! { * fs.WholeWriteEffects; * env.GetEffects; }
= caps => [
  root := env.get caps.env "SLIME_IMAGE_ATTESTATION_BINDINGS_ROOT" ?? ".";
  path := t.join "" { root; "/image_attestation_contract.py"; };
  fs.writeAll caps.write path render
];

main
