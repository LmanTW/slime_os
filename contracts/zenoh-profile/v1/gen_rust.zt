-- Pure renderer for the Zenoh Profile 0 vocabulary (R0).
--
-- This contract declares no wire records, so there is no layout to reflect:
-- the renderer validates the declared bounds and refusal vocabulary, then
-- emits scalar constants and the closed refusal-class table for Rust. The codec
-- in `components/lib/src/zenoh_profile0.rs` takes every bound, identifier and
-- refusal code from these bindings.

n ::= import stdlib.num;
w ::= import wire.rust;

RefusalClass :: type { ident : Text; name : Text; code : Int; };

Profile :: type {
  formatVersion : Int;
  protocolVersion : Int;
  whatamiRouter : Int;
  whatamiPeer : Int;
  whatamiClient : Int;
  defaultResolution : Int;
  streamLengthBytes : Int;
  maxBatchBytes : Int;
  maxKeyBytes : Int;
  maxAttachmentBytes : Int;
  maxPayloadBytes : Int;
  maxCookieBytes : Int;
  maxZidBytes : Int;
  gidBytes : Int;
  leb128MaxBits : Int;
  leb128ShortBits : Int;
  idInit : Int;
  idOpen : Int;
  idClose : Int;
  idFrame : Int;
  idPush : Int;
  idDeclare : Int;
  idDeclareSubscriber : Int;
  idUndeclareSubscriber : Int;
  idPut : Int;
  flagBit5 : Int;
  flagBit6 : Int;
  flagExtensions : Int;
  extWireExpr : Int;
  extAttachment : Int;
  closeGeneric : Int;
  closeUnsupported : Int;
  closeInvalid : Int;
  closeMaxSessions : Int;
  closeMaxLinks : Int;
  closeExpired : Int;
  closeUnresponsive : Int;
  closeConnectionToSelf : Int;
  refusalClasses : List RefusalClass;
};

-- Codes run one, two, three... in declaration order, so a table position and
-- a code can never disagree, and zero stays free for "accepted".
codesSequential :: Int -> List RefusalClass -> Bool
  = expected classes => match classes {
    | {;} => true;
    | { class; ...rest } => class.code == expected && codesSequential (expected + 1) rest;
  };

count :: Int -> List RefusalClass -> Int
  = total classes => match classes {
    | {;} => total;
    | { _; ...rest } => count (total + 1) rest;
  };

rustRefusalConsts :: List RefusalClass -> Text
  = classes => match classes {
    | {;} => "";
    | { class; ...rest } => w.join {
      "pub const REFUSAL_"; class.ident; ": u8 = "; n.toText class.code; ";\n";
      rustRefusalConsts rest;
    };
  };

rustRefusalNames :: List RefusalClass -> Text
  = classes => match classes {
    | {;} => "";
    | { class; ...rest } => w.join {
      "        REFUSAL_"; class.ident; " => Some(\""; class.name; "\"),\n";
      rustRefusalNames rest;
    };
  };

valid :: Profile -> Bool
  = p =>
    p.formatVersion == 1
      && p.protocolVersion == 9
      && p.whatamiPeer == 1
      && p.streamLengthBytes == 2
      && p.maxBatchBytes > 0
      && p.maxBatchBytes <= 65535
      && p.maxKeyBytes > 0
      && p.maxKeyBytes < p.maxBatchBytes
      && p.maxAttachmentBytes > p.gidBytes
      && p.maxAttachmentBytes < p.maxBatchBytes
      && p.maxPayloadBytes > 0
      && p.maxPayloadBytes < p.maxBatchBytes
      && p.maxCookieBytes > 0
      && p.maxCookieBytes < p.maxBatchBytes
      && p.maxZidBytes == 16
      && p.gidBytes == 16
      && p.leb128ShortBits == 16
      && p.leb128MaxBits == 32
      && p.idInit != p.idOpen
      && p.idOpen != p.idClose
      && p.idClose != p.idFrame
      && p.idPush != p.idDeclare
      && p.idDeclareSubscriber != p.idUndeclareSubscriber
      && p.flagBit5 == 32
      && p.flagBit6 == 64
      && p.flagExtensions == 128
      && p.closeConnectionToSelf == 7
      && codesSequential 1 p.refusalClasses
      && count 0 p.refusalClasses == 15;

rustBindings :: Profile -> Text
  = p => w.join {
    "// @generated by contracts/zenoh-profile/v1/gen_rust.zt; do not edit.\n";
    "// Source contract: contracts/zenoh-profile/v1/schema.zt\n\n";
    w.u32Const "FORMAT_VERSION" p.formatVersion;
    w.u32Const "PROTOCOL_VERSION" p.protocolVersion;
    w.u32Const "WHATAMI_ROUTER" p.whatamiRouter;
    w.u32Const "WHATAMI_PEER" p.whatamiPeer;
    w.u32Const "WHATAMI_CLIENT" p.whatamiClient;
    w.u32Const "DEFAULT_RESOLUTION" p.defaultResolution;
    w.usizeConst "STREAM_LENGTH_BYTES" p.streamLengthBytes;
    "\n";
    w.usizeConst "MAX_BATCH_BYTES" p.maxBatchBytes;
    w.usizeConst "MAX_KEY_BYTES" p.maxKeyBytes;
    w.usizeConst "MAX_ATTACHMENT_BYTES" p.maxAttachmentBytes;
    w.usizeConst "MAX_PAYLOAD_BYTES" p.maxPayloadBytes;
    w.usizeConst "MAX_COOKIE_BYTES" p.maxCookieBytes;
    w.usizeConst "MAX_ZID_BYTES" p.maxZidBytes;
    w.usizeConst "GID_BYTES" p.gidBytes;
    w.u32Const "LEB128_MAX_BITS" p.leb128MaxBits;
    w.u32Const "LEB128_SHORT_BITS" p.leb128ShortBits;
    "\n";
    w.u32Const "ID_INIT" p.idInit;
    w.u32Const "ID_OPEN" p.idOpen;
    w.u32Const "ID_CLOSE" p.idClose;
    w.u32Const "ID_FRAME" p.idFrame;
    w.u32Const "ID_PUSH" p.idPush;
    w.u32Const "ID_DECLARE" p.idDeclare;
    w.u32Const "ID_DECLARE_SUBSCRIBER" p.idDeclareSubscriber;
    w.u32Const "ID_UNDECLARE_SUBSCRIBER" p.idUndeclareSubscriber;
    w.u32Const "ID_PUT" p.idPut;
    "\n";
    w.u32Const "FLAG_BIT5" p.flagBit5;
    w.u32Const "FLAG_BIT6" p.flagBit6;
    w.u32Const "FLAG_EXTENSIONS" p.flagExtensions;
    w.u32Const "EXT_WIRE_EXPR" p.extWireExpr;
    w.u32Const "EXT_ATTACHMENT" p.extAttachment;
    "\n";
    w.u32Const "CLOSE_GENERIC" p.closeGeneric;
    w.u32Const "CLOSE_UNSUPPORTED" p.closeUnsupported;
    w.u32Const "CLOSE_INVALID" p.closeInvalid;
    w.u32Const "CLOSE_MAX_SESSIONS" p.closeMaxSessions;
    w.u32Const "CLOSE_MAX_LINKS" p.closeMaxLinks;
    w.u32Const "CLOSE_EXPIRED" p.closeExpired;
    w.u32Const "CLOSE_UNRESPONSIVE" p.closeUnresponsive;
    w.u32Const "CLOSE_CONNECTION_TO_SELF" p.closeConnectionToSelf;
    "\n";
    "/// Why a decoder refuses input. Zero is reserved for accepted input.\n";
    rustRefusalConsts p.refusalClasses;
    w.usizeConst "REFUSAL_CLASS_COUNT" (count 0 p.refusalClasses);
    "\n";
    "/// The class's wire name, as a probe reports it.\n";
    "pub const fn refusal_name(code: u8) -> Option<&'static str> {\n";
    "    match code {\n";
    rustRefusalNames p.refusalClasses;
    "        _ => None,\n";
    "    }\n";
    "}\n";
  };

render :: Profile -> { rust : Text; }
  = p => if valid p
    then { rust = rustBindings p; }
    else { rust = "INVALID_ZENOH_PROFILE_SCHEMA"; };

{ render =; }
