-- Slime OS generation manifest schema, format version 1.
--
-- This module owns the typed host-side validation boundary. The boot-time binary
-- encoding is deliberately not frozen by this source schema.

-- Enumerated identifiers remain Text at the serialization boundary in format 1.
-- The builder validates the closed value sets documented with this contract.

privatePolicy ::= import private_policy.declarations;

Object :: type {
  id : Text;
  kind : Text;
  size : Int;
};

Executable :: type {
  name : Text;
  object : Text;
  role : Text;
  -- Optional per-executable stack size in bytes for the component image.
  stackBytes? : Int;
  spawnBudget : Int;
  commandProfile : List Text;
};

-- One instance's view of a grant. `slot` is the destination capability slot in
-- the holder's table. Omitting it asks the generation builder to assign one
-- deterministically, ordered by grant name within this holder's namespace --
-- which is what a manifest should do unless a frozen artifact pins the number.
-- Explicit slots stay authoritative: the boot-layout fixtures are byte-pinned,
-- so auto-allocation is opt-in per binding rather than a global renumbering.
--
-- `slotReason` is the machine-readable answer to "why is this number written
-- down?" (B91). Before it existed, a pin carried no distinction between a number
-- some external artifact freezes, a number a neighbouring binding's allocation
-- depends on, a number the encoded layout would change without, and a number the
-- allocator reproduces exactly -- so no gate could tell a load-bearing pin from
-- leftover noise, and the only way to find out was to delete one and boot.
-- Required exactly when `slot` is present and refused when it is absent, so the
-- two fields cannot disagree. Closed to four values, ordered strongest first:
--
--   `bootLayout`     -- this manifest's `bootstrapInstance` holds the binding and
--                       it produces a `contracts/boot-layout/v1` row, whose
--                       `*.layout` fixtures freeze the number byte for byte.
--   `allocatorOrder` -- removing this one pin would move some *other* resolved
--                       slot, because the freed number goes to the next binding
--                       in grant-name order. Load-bearing for its neighbours
--                       regardless of who consumes it.
--   `encodedLayout`  -- removing it changes only this binding's own encoded slot.
--                       Nothing else in the manifest depends on the number, but
--                       the generation bytes and the capability layout the root
--                       installs do, so dropping it changes what boots.
--   `componentAbi`   -- none of the above: the allocator reproduces this number
--                       exactly and nothing encoded moves if the pin goes, so
--                       whatever keeps it is outside the manifest -- the holder's
--                       own source, a spawn-grant order, or a device/protocol
--                       layout consuming the position rather than the name.
--
-- The first three are decidable from the manifest alone, so the builder measures
-- each pin's removal and refuses any label it cannot confirm. A weaker claim
-- beside a stronger truth is refused too, which is what makes the vocabulary
-- ordered rather than free: a pin carries the strongest invariant forcing it.
--
-- `componentAbi` is the only reason resting on a claim about component source,
-- and therefore the only class `just contracts_check` can audit against the
-- components themselves and the only class a future migration can shrink. That
-- is the residue B91 leaves deliberately visible instead of hidden among 613
-- undifferentiated numbers.
InstanceBinding :: type {
  grant : Text;
  slot? : Int;
  slotReason? : Text;
};

-- One statically-created seL4 Notification. `source` is the instance allowed
-- to signal it and `target` is the instance that waits on it. A stream ring
-- declares two: ready flows producer to consumer; credit flows consumer to
-- producer.
NotificationGrant :: type {
  name : Text;
  source : Text;
  target : Text;
};

-- One holder's view of a NotificationGrant. Slots are relative to the native
-- notification region (48..62), hence the closed 0..14 range validated by the
-- generation builder. `role` is closed to `signal` or `wait`. `slot` may be
-- omitted to have the builder assign it within this holder's notification
-- namespace, which is disjoint from its capability slots.
NotificationBinding :: type {
  grant : Text;
  holder : Text;
  slot? : Int;
  role : Text;
};

Instance :: type {
  name : Text;
  executable : Text;
  owner : Text;
  autostart : Bool;
  dependencies : List Text;
  health : Text;
  -- `resident` or `bounded`. A manifest derived from a system spec states it
  -- for every instance; absent means `bounded`. The builder emits the
  -- `instance-lifetime` object naming the resident instances exactly when one
  -- is declared, and the root treats a resident instance's exit as a failure.
  lifetime? : Text;
  bindings : List InstanceBinding;
  -- Scheduling priority for this instance's initial thread.
  --
  -- The v5 wire format has carried a `ScheduleRecord` with `priority`,
  -- `budget_us`, and `period_us` per thread since the cutover, but nothing
  -- declared one: the builder wrote a constant and the root ignored it,
  -- running every child at one fixed number. This is the manifest's side of
  -- that record.
  --
  -- Absent means the root's default, one below its own so the service loop
  -- always preempts a runnable child. Bounded by that default rather than by
  -- seL4's 255: a child at or above the root's priority can keep the service
  -- loop from running and stall every other child behind it.
  --
  -- Budget and period stay undeclared until MCS is admitted; without it seL4
  -- has no notion of either, and a number the kernel cannot enforce would be
  -- authenticated fiction.
  priority? : Int;
  -- Extra threads in this instance's process, beyond its main one.
  --
  -- A process owns the CSpace and VSpace; a thread owns a TCB, an IPC buffer,
  -- a fault policy, and a schedule. v5 has separated them since the cutover,
  -- but the builder emitted exactly one thread per process and indexed the two
  -- tables 1:1, so the split existed in the format and nowhere else (B47).
  --
  -- Each extra thread gets its own TCB, IPC buffer, fault policy, and
  -- schedule, and shares the declaring instance's CSpace and VSpace — which is
  -- the property that distinguishes a second thread from a second process.
  extraThreads? : Int;
  -- Scheduling priority for this instance's extra threads.
  --
  -- Defaults to `priority`, so a worker runs alongside its main thread unless
  -- the manifest says otherwise. Declaring it lower is the case that matters:
  -- a component can then hold a busy thread without stalling its own IPC, and
  -- an unrelated higher-priority service keeps running (B48). The
  -- `ScheduleRecord` has always been per-thread; this is the manifest side of
  -- that.
  --
  -- Bounded like `priority`, and refused rather than clamped.
  workerPriority? : Int;
};

CapabilityGrant :: type {
  name : Text;
  source : Text;
  target : Text;
  capabilityKind : Text;
  rights : List Text;
  transferable : Bool;
};

StateBinding :: type {
  name : Text;
  owner : Text;
  schemaVersion : Int;
  policy : Text;
};

-- One capability an owner mints at runtime and hands to an instance it owns at
-- spawn. A CapabilityGrant names a concrete authority edge between two declared
-- endpoints; a channel endpoint minted after activation has no object to name,
-- so it is declared here instead of degrading a grant to a rights assertion.
-- Owner, holder, destination slot, and the exact rights ceiling are all fixed
-- before activation; only the object identity is deferred. `slot` may be
-- omitted to have the builder assign it, on the same terms as InstanceBinding.
MintedBinding :: type {
  name : Text;
  owner : Text;
  holder : Text;
  capabilityKind : Text;
  slot? : Int;
  rights : List Text;
  transferable : Bool;
};

-- Per-holder C7 shared-buffer quota carried by the authenticated generation.
-- Omission is deny-by-default; each listed ceiling is absolute live usage.
SharedBufferBudgetEntry :: type {
  holder : Text;
  bytePages : Int;
  bufferCount : Int;
  mappingCount : Int;
  loanCount : Int;
};

-- Per-holder C10.2 private-memory quota carried by the authenticated
-- generation: the absolute page ceiling a component's task-private region may
-- ever be grown to. Omission is deny-by-default, exactly as for
-- `sharedBufferBudget` — a component absent from this list grows nothing.
--
-- A separate list rather than a fifth column on `SharedBufferBudgetEntry`: the
-- two bound unrelated mechanisms, and most components use one and not the
-- other, so a merged record would make every holder restate a quota for a
-- mechanism it does not touch.
PrivateMemoryBudgetEntry :: type {
  holder : Text;
  pageQuota : Int;
};
-- IO1 per-driver hardware-resource ceilings. The holder is the authenticated
-- instance identity; omission denies every IO-resource operation.
IoResourceBudgetEntry :: type {
  holder : Text;
  mmioBytes : Int;
  mmioMappings : Int;
  dmaPages : Int;
  dmaMappings : Int;
  irqSources : Int;
  outstandingRequests : Int;
  bufferLoans : Int;
  -- Which attached transport this driver instance drives, zero-based in the
  -- platform's stable device order (B84). Optional because a single-device
  -- plane has nothing to choose; omission means device 0.
  --
  -- Stated here rather than derived, and rather than carried on the grant
  -- record. A plane with two disks declares one driver executable twice, and
  -- the root assigns every non-block typed grant in an instance one positional
  -- index -- so both instances' grants are identical and cannot name a device.
  -- This record is already keyed by the instance identity, and one number names
  -- the device for that instance's device/mmioRegion/interruptSource/dmaAccount
  -- authority at once, so the four cannot disagree about which transport they
  -- mean. Two holders naming one device is refused: a transport is exclusive.
  device? : Int;
};

-- B83 exact per-ring block authority. Each entry binds one client instance,
-- on one device, to one IO0 ring, with independent read and write rights and a
-- declared sector ceiling.
--
-- Rights live on the ring rather than on a submission because an IO0 ring is
-- shared memory: a submission carries a request, a slice, and a lease but no
-- rights identity, so a driver serving the ring has no caller badge to derive
-- authority from. Two clients whose rights differ therefore use two rings.
--
-- No field can widen: there is no wildcard holder, no device range, and no
-- rights value meaning "all".
BlockRingAuthorityEntry :: type {
  holder : Text;
  device : Int;
  ring : Int;
  rights : List Text;
  sectorLimit : Int;
};

-- IO4 exact destination authority and every bound the userspace network
-- service may consume for that tuple. Address is either a dotted IPv4 literal,
-- an IPv6 literal, or one exact DNS name according to `addressKind`; no field
-- can express a prefix, range, wildcard, or resolver-wide grant.
NetworkDestinationEntry :: type {
  holder : Text;
  transport : Text;
  addressKind : Text;
  address : Text;
  port : Int;
  rights : List Text;
  queueDepth : Int;
  byteBudget : Int;
  timerBudget : Int;
  retryLimit : Int;
  reconnectLimit : Int;
  socketLimit : Int;
  listenerLimit : Int;
  dnsRecordLimit : Int;
};

-- IO11 static interface declaration: the IPv4 address and prefix a holder's
-- stack configures on its link, the gateway it routes off-link traffic to
-- (`0.0.0.0` for none), and the MAC it presents. No lease, discovery, or
-- negotiation field exists; the declared network service reads its own row.
NetworkInterfaceEntry :: type {
  holder : Text;
  address : Text;
  prefixLen : Int;
  gateway : Text;
  mac : Text;
};

-- Entropy authority row: a holder that may draw from the declared entropy
-- service, whether its stream is instantiated from the hardware source or from
-- `seed` (64 lowercase hex digits, seeded rows only), and the total bytes it
-- may draw. Encoded as `contracts/entropy-authority/v1`.
EntropyAuthorityEntry :: type {
  holder : Text;
  source : Text;
  byteBudget : Int;
  seed? : Text;
};

-- Zenoh service grant row: one holder, one exact Zenoh key, and the rights to
-- publish and to subscribe on it. Encoded as `contracts/zenoh-service-grants-table/v1`.
ZenohGrantEntry :: type {
  holder : Text;
  key : Text;
  publish : Bool;
  subscribe : Bool;
};

-- Application bindings and exact local listener policy, distinct from remote destinations.
NetworkApplicationEntry :: type {
  holder : Text;
  controlBinding : Text;
  provisionBinding : Text;
  supervisionBinding : Text;
  requestNotification : Text;
  completionNotification : Text;
  role : Text;
  backend : Text;
  localAddress : Text;
  localPort : Int;
  admittedPeer : Text;
  admittedPeerAddress : Text;
  rights : List Text;
  backlog : Int;
  acceptedSocketLimit : Int;
  byteBudget : Int;
  timerBudget : Int;
  queueDepth : Int;
  retryLimit : Int;
  reconnectLimit : Int;
  -- network-application/v3 TCP options for every socket the row opens or accepts.
  keepaliveMs : Int;
  idleTimeoutMs : Int;
  hopLimit : Int;
  nagle : Bool;
  -- network-application/v4 buffer sizes for every socket the row opens or accepts.
  rxBufferBytes : Int;
  txBufferBytes : Int;
};

-- One instance's C9.1 root-brokered clock service authority. The three
-- booleans are independent, and simulated time has separate read and advance
-- authority so a consumer cannot change the test clock it observes. Reading
-- the monotonic clock is ambient (`clock-authority/v2`) and is not declared. `timerQuota` must be nonzero only
-- with `timerUse`; `timerNotification` then names the generation-owned
-- NotificationGrant whose target is this holder, and `timerBadgeBit` is the
-- single badge bit expiry signals accumulate on that notification.
ClockAuthorityEntry :: type {
  holder : Text;
  timerUse : Bool;
  simulatedRead : Bool;
  simulatedAdvance : Bool;
  timerQuota : Int;
  timerNotification? : Text;
  timerBadgeBit? : Int;
};

-- One declared wake source in a waiter's C9.2 wait set: which badge bit on
-- which of its Notification grants means what, and which of its own slots to
-- drain when that bit arrives.
--
-- Declared rather than derived because a waiter cannot derive it. `slime-root`
-- computes a signaller's badge from the *signaller's* declared slot, which is a
-- fact about the peer, and C9.1's timer badge is contract data independent of
-- any slot; nothing in either table says whether a bit is a stream ingress, a
-- call reply, or a peer death. `kind` is one of `stream`, `call`, `operation`,
-- `timer`, `supervision`, `qosEvent`, or `device` (wait-set/v2). `drainSlot` is
-- the waiter's own slot and is omitted exactly for `timer` and `device`, which
-- deliver no payload.
WaitSetSourceEntry :: type {
  waiter : Text;
  notification : Text;
  badgeBit : Int;
  kind : Text;
  drainSlot? : Int;
};

-- The concrete TCB priority one C9.3 scheduling class runs at.
--
-- The mapping is manifest data rather than a constant in the builder and a
-- matching constant in the root, because C9.3's deliverable is that a
-- composition declares its own band layout. `class` is one of `foreground`,
-- `normal`, or `bestEffort`; every class the resource uses must have exactly
-- one band, and no two bands may share a priority — two names for one priority
-- is a mapping that cannot be observed.
SchedulingClassBand :: type {
  class : Text;
  priority : Int;
};

-- One instance's declared C9.3 scheduling class.
--
-- `class` is the band this instance's main thread runs at; `workerClass`
-- defaults to `class` and is the band its extra threads run at, which is the
-- B48 case: a component may hold a busy worker without its own IPC thread
-- inheriting that band.
--
-- Deny-by-default here means the declared `normal` band, not refusal: every
-- thread the root launches already runs at some priority, so an instance the
-- table omits has a correct answer rather than a denial. A class is ordering,
-- not a reservation — CPU quantity is bounded by nothing here, because
-- `KernelIsMCS OFF` leaves the kernel no budget to charge (B77).
SchedulingClassEntry :: type {
  instance : Text;
  class : Text;
  workerClass? : Text;
};

-- One C9.3 promotion edge: `holder` may set `subject`'s class at runtime, to
-- any declared band at or below `ceiling`'s priority.
--
-- `holder` and `subject` must differ. That is the "no component can widen
-- itself" rule made structural rather than a runtime name comparison: a
-- self-edge is refused by the builder and by the decoder, so a self-widening
-- component is a generation that does not decode rather than a request the root
-- must remember to say no to.
--
-- The ceiling is per-edge so a supervisor trusted to raise one component into
-- `foreground` is not thereby trusted to raise every component it can name.
SchedulingPromotionEntry :: type {
  holder : Text;
  subject : Text;
  ceiling : Text;
};

-- The C9.3 scheduling-class table: the band mapping, the per-instance
-- assignment, and the promotion edges, together because none of the three is
-- meaningful without the other two.
SchedulingClassPolicy :: type {
  bands : List SchedulingClassBand;
  instances : List SchedulingClassEntry;
  promotions : List SchedulingPromotionEntry;
};

-- One admitted C9.4 lifecycle transition. `from` and `to` are the
-- `contracts/component-spec/v1` state spellings — `Initialize`, `Configure`,
-- `Start`, `Ready`, `Running`, `Degraded`, `Stop`, `Error` — promoted from that
-- host-only declarative list into an edge a generation admits and the root
-- refuses departures from.
--
-- Directed: declaring `Running -> Degraded` does not admit the reverse, because
-- a composition where every degradation is silently recoverable has declared no
-- degradation policy.
LifecycleTransition :: type {
  from : Text;
  to : Text;
};

-- One instance's C9.4 restart policy.
--
-- `attempts` is the number of *restarts* admitted after the first launch, so
-- zero is the pre-C9.4 behaviour stated explicitly rather than by omission.
-- `causes` names the terminal causes this policy restarts on -- `exit`,
-- `fault`, `unhealthy`, `timeout`, `peerLoss` -- so a component restarted on a
-- fault but not on a clean exit is one entry rather than two tables, and the
-- three causes C9.4's first required check must distinguish are distinguishable
-- in the declaration as well as in the observation.
--
-- `backoffNs` is the delay before the first restart in counter ticks, and
-- `backoffFactor` scales it per attempt in 256th parts, so 256 is flat and 512
-- doubles. Both readers resolve the same declared numbers: the supervisor arms a
-- C9.1 timer for the computed delay and the root independently refuses a restart
-- that arrives early, which is what makes backoff an observed property rather
-- than a trusted one.
LifecycleRestartPolicy :: type {
  instance : Text;
  attempts : Int;
  causes : List Text;
  backoffNs : Int;
  backoffFactor? : Int;
};

-- One C9.4 health dependency: `instance` is not started while `dependency` has
-- not reached `requiredState`.
--
-- Distinct from `Instance.dependencies`, which is a one-shot activation barrier
-- the root evaluates once at autostart. This edge is evaluated on every start
-- *including a restart*, and it names the exact state the dependency must be in,
-- because a dependent needing its dependency merely launched and one needing it
-- serving are different policies.
LifecycleHealthDependency :: type {
  instance : Text;
  dependency : Text;
  requiredState : Text;
};

-- One C9.4 parameter-state authority edge: `holder` may read and/or write
-- `subject`'s parameters.
--
-- This is what makes parameter state an *authority* rather than a schema. An
-- instance holding no edge can reach no parameters at all, its own included, and
-- `holder == subject` is admitted here -- unlike a scheduling promotion edge --
-- because a component owning its own configuration is the ordinary case.
LifecycleParameterGrant :: type {
  holder : Text;
  subject : Text;
  read : Bool;
  write : Bool;
};

-- The C9.4 lifecycle policy: the admitted transition graph with its entry and
-- exhaustion states, the per-instance restart bounds and backoff, the health
-- dependencies gating a start, and the parameter authority. Declared together
-- because a restart bound without a terminal state, or a transition graph
-- without an entry, is not a policy.
--
-- `terminalState` is the state an instance enters when its attempt bound is
-- spent. One graph-wide state rather than one per instance, so "the graph is in
-- a declared terminal state rather than restarting forever" is observable in one
-- marker.
LifecyclePolicy :: type {
  initialState : Text;
  terminalState : Text;
  transitions : List LifecycleTransition;
  restarts : List LifecycleRestartPolicy;
  dependencies : List LifecycleHealthDependency;
  parameters : List LifecycleParameterGrant;
};

-- One instance's declared C9.5 participation in a recording stream.
--
-- `stream` names the recording; exactly one `record` entry and one `replay`
-- entry must name each stream, because a stream with two recorders has two
-- writers for one artifact and a stream with two replayers compares one
-- recording against itself.
--
-- `deterministic` is the claim C9.5 constrains, and declaring it is not
-- sufficient to hold it: the builder joins this entry against the grants the
-- generation gives this instance and refuses the manifest when any of them names
-- an unrecorded nondeterminism source, per the `determinism` classification each
-- right carries in `contracts/generation/v5`. A recorder that is not itself
-- deterministic is a real case — capturing inputs faithfully is not the same as
-- being reproducible — so the flag is per entry rather than per stream.
--
-- `streamGrant` names the grant the recording itself arrives over, and only a
-- `replay` entry may declare one. It is the declared exception to that join:
-- every authority carrying bytes into a component is an unrecorded source,
-- `recv` included, so a replayer needs one such grant to receive the very
-- recording it replays and would otherwise be refused for holding it. The
-- builder and the root each subtract exactly this grant's rights and check
-- everything else unchanged. Declared rather than inferred, because inferring
-- which of a component's endpoints carries its recording means guessing, and a
-- wrong guess exempts a live input.
--
-- `recordCapacity` is records, not bytes, and both ends of a stream must declare
-- the same number: one recording has one length.
RecordingEntry :: type {
  instance : Text;
  stream : Text;
  streamGrant? : Text;
  role : Text;
  deterministic : Bool;
  recordCapacity : Int;
};

-- One named full-graph profile override. Profiles may replace only an exact
-- participant's interposition chain; every other authority and policy field
-- remains fixed by the base graph.
FabricProfileInterposition :: type {
  route : Text;
  participant : Text;
  chain : List Text;
};

-- A named full-graph profile.
--
-- `streamControls` is the ordered stream control-grant list this profile's
-- broker indexes. Order is authority-bearing: a broker resolves a client's
-- control slot as `FABRIC_FIRST_CONTROL_SLOT + position`, so reordering this
-- list renumbers real capability slots. It is declared here rather than
-- selected by the builder from the profile's *name* (B60) — a Python string
-- comparison on `"unified"`/`"matrix"` made the builder the authority on which
-- grants form a control plane while the manifest merely had to agree.
--
-- Empty means "this profile does not declare its own stream plane", and the
-- builder falls back to the single-broker default. The call and operation
-- planes need no equivalent: their grant sets do not vary by profile.
FabricProfile :: type {
  name : Text;
  interpositions : List FabricProfileInterposition;
  streamControls : List Text;
};

-- One named boot profile: which instances the generation declares beyond the
-- product set, and which fabric interposition chains apply (B11).
BootProfile :: type {
  name : Text;
  fabricProfile : Text;
  instances : List Text;
  requiredInstances : List Text;
};

-- One participant's exact role on one fabric route (C8.2). `interposition` is
-- the ordered proxy chain, outermost first; an empty list is a direct edge.
FabricParticipant :: type {
  component : Text;
  direction : Text;
  visibility : Text;
  interposition : List Text;
  reliability : Text;
  durability : Text;
  liveliness : Text;
  historyDepth : Int;
  retainedDepth : Int;
  deadlineNs : Int;
  lifespanNs : Int;
  leaseNs : Int;
};

FabricRoute :: type {
  name : Text;
  interface : Text;
  participants : List FabricParticipant;
};

-- Every per-graph resource ceiling the fabric and its clients are admitted
-- against. Nothing at runtime may raise them.
FabricLimits :: type {
  routes : Int;
  ingressSources : Int;
  publishers : Int;
  subscribers : Int;
  clients : Int;
  servers : Int;
  sampleBytes : Int;
  queueDepth : Int;
  historyDepth : Int;
  eventDepth : Int;
  retainedSamples : Int;
  retries : Int;
  inFlightCalls : Int;
  inFlightOperations : Int;
  bufferPages : Int;
  mappings : Int;
  loans : Int;
  capabilitySlots : Int;
  buffers : Int;
};

-- `traceDepth` and `traceOverflow` fix the C8.11 bounded semantic-trace sink:
-- how many records one worker's sink holds, and what it does when full. They
-- are graph facts rather than component choices because the deterministic
-- evidence stream is only comparable across boots if every worker in the graph
-- agrees on the sink's capacity and its overflow discipline. `traceOverflow` is
-- `saturate`, the one discipline `contracts/fabric-trace/v1/` defines: a full
-- sink refuses further ordinary records and counts them, so loss is reported
-- rather than silent.
FabricGraph :: type {
  fabricComponent : Text;
  limits : FabricLimits;
  traceDepth : Int;
  traceOverflow : Text;
  routes : List FabricRoute;
  profiles : List FabricProfile;
};

HealthPolicy :: type {
  bootAttempts : Int;
  requiredInstances : List Text;
};

GenerationManifest :: type {
  formatVersion : Int;
  generation : Int;
  target : Text;
  parent? : Int;
  -- Authenticated init composition selector. It travels in the v5 process
  -- record and is passed to the bootstrap thread at activation; component
  -- images never select a graph through build-time environment flags.
  bootAction : Text;
  bootstrapInstance : Text;
  interfaceSchemas : List Text;
  sharedBufferBudget : List SharedBufferBudgetEntry;
  -- Optional C10.2 private-memory budget. Absent means the generation declares
  -- no private-memory quota at all, and every component is denied — the same
  -- answer an empty list gives. Optional rather than required so a composition
  -- that grants nobody working memory says so by omission instead of carrying
  -- an empty list it never reads.
  privateMemoryBudget? : List PrivateMemoryBudgetEntry;
  -- Mutually exclusive with privateMemoryBudget, including an explicit empty list.
  privateMemoryPolicy? : privatePolicy.Policy;
  -- Optional IO1 hardware-resource budget. Like the shared-buffer and private
  -- memory budgets, this is emitted as an authenticated resource object;
  -- absence and an empty list both deny every holder.
  ioResourceBudget? : List IoResourceBudgetEntry;
  -- Optional IO4 exact-destination table. Absent and empty both grant no
  -- network destination. The authenticated resource object is readable only
  -- by the declared network service; clients receive typed service authority.
  networkDestinations? : List NetworkDestinationEntry;
  -- Optional IO11 interface table. Absent and empty both declare no interface,
  -- so a network service with a link and no row configures nothing.
  networkInterfaces? : List NetworkInterfaceEntry;
  networkApplications? : List NetworkApplicationEntry;
  -- Optional entropy authority table. Absent and empty both grant no holder
  -- any entropy; readable only by the instance named `entropy-service`.
  entropyAuthority? : List EntropyAuthorityEntry;
  -- Optional Zenoh service grants table. Absent and empty both grant no holder
  -- any Zenoh right; readable only by the instance named `zenoh-service`.
  zenohGrants? : List ZenohGrantEntry;
  -- Optional B83 exact per-ring block authority table. Absent and empty both
  -- grant no ring any block right, so a userspace block driver refuses every
  -- submission rather than defaulting open. Readable only by the declared
  -- block driver, through the same authenticated cursor-paged path as the IO4
  -- destination table.
  blockRingAuthority? : List BlockRingAuthorityEntry;
  -- Optional C9.1 clock service authority. Absent and empty both deny every
  -- root-brokered clock operation; raw counter access is outside this service
  -- contract as documented by contracts/clock-authority/v1.
  clockAuthority? : List ClockAuthorityEntry;
  -- Optional C9.2 wait-set source table. Absent and empty both mean no
  -- component may register a wake source, so a wait set built by an undeclared
  -- waiter has nothing to dispatch — the deny-by-default answer rather than an
  -- unbounded one.
  waitSet? : List WaitSetSourceEntry;
  -- Optional C9.3 scheduling-class policy. Absent means the generation declares
  -- no class policy: every instance runs at the root's default child priority,
  -- which is what every generation before C9.3 did. Present, it fixes the band
  -- mapping, every named instance's class, and who may promote whom.
  schedulingClass? : SchedulingClassPolicy;
  -- Optional C9.4 lifecycle policy. Absent means the generation declares no
  -- lifecycle graph, no restart bound, no health dependency, and no parameter
  -- authority: nothing restarts, every transition request is refused, and no
  -- component can reach any parameter — which is what every generation before
  -- C9.4 did, stated rather than inferred.
  lifecyclePolicy? : LifecyclePolicy;
  -- Optional C9.5 recording table. Absent and empty both mean no instance is
  -- declared deterministic and no recording stream exists, so nothing is
  -- recorded and nothing replays — the deny-by-default answer, and what every
  -- generation before C9.5 did.
  recording? : List RecordingEntry;
  objects : List Object;
  executables : List Executable;
  instances : List Instance;
  grants : List CapabilityGrant;
  mintedBindings : List MintedBinding;
  notificationGrants? : List NotificationGrant;
  notificationBindings? : List NotificationBinding;
  state : List StateBinding;
  -- Fallback health policy, used by a profile that declares no required set of
  -- its own.
  health : HealthPolicy;
  bootProfiles : List BootProfile;
  -- Optional C8.2 fabric graph. Absent means the generation declares no
  -- native data fabric; no component then receives any route authority.
  fabricGraph? : FabricGraph;
};

