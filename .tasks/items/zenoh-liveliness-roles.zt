s ::= import "./schema.zt";
h ::= import "./helpers.zt";

item :: s.Item = (h.task "01a208ef-1ac1-73c3-91bb-2a4315bf72a4" "zenoh-liveliness-roles" "zenoh-transport"
  "Answer a router's token INTEREST from a client-role session, and admit a Client INIT_SYN on a listener"
  "A client-role session declares and withdraws liveliness tokens (zenoh-rmw-token), but it refuses an INTEREST as an unsupported message. A router that asks a client for the tokens it holds therefore gets no answer, and a router that never saw the client declare them cannot list the node. A listener also refuses every INIT_SYN that names Client, so a Slime listener cannot serve a client. Upstream eclipse-zenoh 1.0.0 writes an INTEREST for tokens as `0x39 <id> 0x08`, or restricted to a key as `0x39 <id> 0x78 <key>`, and answers it with a DECLARE_TOKEN for each selected token carrying the interest id, then a DeclareFinal. An rmw_zenoh peer sends the restricted form, `0x79`, over `@ros2_lv/<domain>/**`.")
  with {
    intent = #planned;
    owns = {
      "components/lib/src/zenoh_profile0.rs";
      "components/lib/src/zenoh_profile0/**";
      "components/lib/src/zenoh_link.rs";
      "components/lib/src/zenoh_link/**";
      "components/lib/src/zenoh_liveliness*";
      "components/lib/src/lib.rs";
    };
    nonGoals = {
      h.nonGoal "The client role itself, and what the session writes when it declares or withdraws a token. zenoh-rmw-token owns both, and this item changes neither frame." h.agentDefault;
      h.nonGoal "The graph session, which reads tokens and answers an INTEREST with a DeclareFinal alone." h.agentDefault;
      h.nonGoal "Router role. A router speaks routing tables and gossip that no admitted message carries; refusing it stays." h.agentDefault;
      h.nonGoal "Queryables, scouting, a wildcard token key and an INTEREST for anything but tokens." h.agentDefault;
      h.nonGoal "A token written by key alias. The session writes each key in full." h.agentDefault;
    };
    requirements = {
      h.req "interest-answer"
        "A client-role session answers an INTEREST for tokens, mode Current or CurrentFuture, with one frame at its next sequence number: a DECLARE_TOKEN for each token it holds whose key the INTEREST selects, in the order it declared them, each carrying the interest id, then one DeclareFinal carrying that id. Mode Future and mode Final answer nothing. A token it withdrew is not answered. An answer that does not fit the batch is refused, and the next frame the session writes takes the number the refused answer would have taken."
        { "zenoh_liveliness_check"; };
      h.req "interest-selection"
        "An INTEREST selects every key when it has no restriction. When it names a key `<prefix>/**` it selects the tokens whose key is under that prefix. The options byte is 0x08 for the first form and 0x78 or 0x79 for the second, and the network QoS extension may follow either. Key expressions may accompany tokens only in the restricted form, so 0x09 is not admitted."
        { "zenoh_liveliness_check"; };
      h.req "interest-refusals"
        "An INTEREST for subscribers, queryables or key expressions only, one that mixes kinds other than key expressions with a restricted tokens interest, the unrestricted key-expressions-and-tokens form 0x09, one restricted to a key with no trailing wildcard or a wildcard inside it, and one with an unknown extension are refused by name. A session with no client role refuses every INTEREST as unsupported-message. Two INTERESTs in one frame are refused whole."
        { "zenoh_liveliness_check"; };
      h.req "liveliness-wire"
        "Every answer frame, the INIT_ACK a listener writes to a Client, and the frame after a refused answer equal the bytes the host reference writes. The reference reproduces 23 batches the upstream eclipse-zenoh 1.0.0 encoder wrote before it judges any frame."
        { "zenoh_liveliness_check"; };
      h.req "listener-admits-clients"
        "A listener built with client admission takes an INIT_SYN that names Client and answers with an INIT_ACK of whatami Peer. A listener without it refuses the same bytes as unsupported-whatami. Router stays unsupported-whatami and the reserved role stays malformed-message in both."
        { "zenoh_liveliness_check"; };
      h.req "defaults-unchanged"
        "A session and a link built as before decode and encode exactly as before. The 17 corpus batches, the stock peer's session, the client role and its router handshakes, the token declaration and withdrawal, the graph session's answer and every existing refusal are reproduced unchanged."
        { "zenoh_encoder_check"; "zenoh_session_check"; "zenoh_stock_check"; "zenoh_links_check"; "zenoh_subscribers_check"; "zenoh_undeclare_check"; "zenoh_transport_check"; "zenoh_rmw_client_check"; "zenoh_rmw_router_link_check"; "zenoh_rmw_token_check"; "zenoh_rmw_graph_check"; };
    };
    acceptance = {
      h.observed "zenoh_liveliness_check";
      h.observed "zenoh_encoder_check";
      h.observed "zenoh_session_check";
      h.observed "zenoh_stock_check";
      h.observed "zenoh_links_check";
      h.observed "zenoh_subscribers_check";
      h.observed "zenoh_undeclare_check";
      h.observed "zenoh_transport_check";
      h.observed "zenoh_rmw_client_check";
      h.observed "zenoh_rmw_router_link_check";
      h.observed "zenoh_rmw_token_check";
      h.observed "zenoh_rmw_graph_check";
    };
    knownLimits = {
      h.knownLimit "zenoh_liveliness_check"
        "verification/zenoh-xcheck is not extended. The upstream bytes of the 23 batches are pinned in scripts/lib/zenoh_wire.py, written once by the upstream 1.0.0 encoder, and the reference must reproduce them. The decoder and session are not run against the upstream crates for interests."
        h.agentDefault;
      h.knownLimit "zenoh_liveliness_check"
        "The answer is written in the form upstream eclipse-zenoh 1.0.0 writes: each DECLARE carries the network QoS extension `21 08`, and the DeclareFinal is `be <id> 21 08 1a`. The declaration zenoh-rmw-token lands is the bare `1e 66` form and the graph session's DeclareFinal is `3e <id> 1a`. The forms differ on purpose and this item changes neither landed form. No capture in the repository shows a router sending a client an INTEREST, so the answer's first observed user is the rmw_zenoh peer the graph session already serves, and the unrestricted form is judged against upstream's encoder only."
        h.agentDefault;
      h.knownLimit "zenoh_liveliness_check"
        "The session stores a key for each token it declares, because the answer carries it. The token table zenoh-rmw-token landed holds ids only, so this item adds the key and its bound to that table and nothing else."
        h.agentDefault;
    };
    decisions = {
      h.decided "build-on-rmw-token"
        "Use the token table and client role zenoh-rmw-token lands, and add only the answer and the listener admission"
        "two token tables and two client mechanisms would each need the other's rollback and sequence-number rules"
        h.agentDefault
        { "interest-answer"; "listener-admits-clients"; };
      h.decided "answer-in-the-session"
        "The session writes the answer while it applies the frame that asked, as the graph session writes its DeclareFinal"
        "the sequence number is spent only when the frame was built, and a refused frame must leave it untouched"
        h.agentDefault
        { "interest-answer"; };
      h.decided "grader-first"
        "The checker slice, the recipe and the host reference land in a planning pull request, and the implementation pull request changes only the paths in owns"
        "V3 keeps a grader out of the implementation pull request"
        h.agentDefault
        { "liveliness-wire"; };
    };
  };

item
