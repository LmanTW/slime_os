s ::= import "./schema.zt";
h ::= import "./helpers.zt";

item :: s.Item = (h.task "01a208ef-1ac1-73c3-91bb-2a4315bf72a4" "zenoh-liveliness-roles" "zenoh-transport"
  "Answer a router's token INTEREST from a client-role session, and admit a Client INIT_SYN on a listener"
  "A client-role session declares and withdraws liveliness tokens (zenoh-rmw-token), but it refuses an INTEREST as an unsupported message. A router that asks a client for the tokens it holds therefore gets no answer, and a router that never saw the client declare them cannot list the node. A listener also refuses every INIT_SYN that names Client, so a Slime listener cannot serve a client. Upstream eclipse-zenoh 1.0.0 writes an INTEREST for tokens as `0x39 <id> 0x08` and answers it with a DECLARE_TOKEN for each token carrying the interest id, then a DeclareFinal.")
  with {
    intent = #planned;
    owns = {
      "components/lib/src/zenoh_profile0.rs";
      "components/lib/src/zenoh_profile0/**";
      "components/lib/src/zenoh_liveliness*";
      "components/lib/src/lib.rs";
    };
    nonGoals = {
      h.nonGoal "The client role itself, token declaration and withdrawal, and the token table. zenoh-rmw-token owns them, and this item uses its API." h.agentDefault;
      h.nonGoal "The graph session, which reads tokens and answers an INTEREST with a DeclareFinal alone." h.agentDefault;
      h.nonGoal "Router role. A router speaks routing tables and gossip that no admitted message carries; refusing it stays." h.agentDefault;
      h.nonGoal "Queryables, scouting, a wildcard token key and an INTEREST for anything but tokens." h.agentDefault;
      h.nonGoal "A token written by key alias, or a QoS extension on a token DECLARE. The plain link writes the key in full with no wrapper." h.agentDefault;
    };
    requirements = {
      h.req "interest-answer"
        "A client-role session answers an INTEREST for tokens, mode Current or CurrentFuture, with one frame at its next sequence number: a DECLARE_TOKEN for each token it holds, in the order it declared them, each carrying the interest id, then one DeclareFinal carrying that id. Mode Future and mode Final answer nothing. A token it withdrew is not answered. An answer that does not fit the batch is refused and spends no sequence number."
        { "zenoh_liveliness_check"; };
      h.req "interest-refusals"
        "An INTEREST for subscribers, queryables or key expressions, one that mixes kinds, one restricted to a key and one with an extension are refused by name. A session with no client role refuses every INTEREST as unsupported-message. Two INTERESTs in one frame are refused whole."
        { "zenoh_liveliness_check"; };
      h.req "liveliness-wire"
        "Every answer frame equals the bytes the host reference writes, and the reference reproduces 16 batches the upstream eclipse-zenoh 1.0.0 encoder wrote before it judges any frame."
        { "zenoh_liveliness_check"; };
      h.req "listener-admits-clients"
        "A listener built with client admission takes an INIT_SYN that names Client and answers with an INIT_ACK as a peer. A listener without it refuses the same bytes as unsupported-whatami. Router stays unsupported-whatami and the reserved role stays malformed-message in both."
        { "zenoh_liveliness_check"; };
      h.req "defaults-unchanged"
        "A session and a link built as before decode and encode exactly as before: the 17 corpus batches, the stock peer's session and every existing refusal are reproduced unchanged."
        { "zenoh_encoder_check"; "zenoh_session_check"; "zenoh_stock_check"; "zenoh_links_check"; "zenoh_subscribers_check"; "zenoh_undeclare_check"; "zenoh_transport_check"; };
    };
    acceptance = {
      h.observed "zenoh_liveliness_check";
      h.observed "zenoh_encoder_check";
      h.observed "zenoh_session_check";
      h.observed "zenoh_stock_check";
      h.observed "zenoh_links_check";
      h.observed "zenoh_subscribers_check";
      h.observed "zenoh_undeclare_check";
      h.observed "zenoh_transport_check";
    };
    knownLimits = {
      h.knownLimit "zenoh_liveliness_check"
        "verification/zenoh-xcheck is not extended. The upstream bytes of the 16 batches are pinned in scripts/lib/zenoh_wire.py, written once by the upstream 1.0.0 encoder, and the reference must reproduce them. The decoder and session are not run against the upstream crates for interests."
        h.agentDefault;
      h.knownLimit "zenoh_liveliness_check"
        "The answer's DECLARE_TOKEN frames carry the network QoS extension upstream writes on a DECLARE. Upstream's plain token declaration (zenoh-rmw-token) carries none. The two forms differ on purpose: the answer is judged against upstream's encoder, the declaration against rmw_zenohd's captures."
        h.agentDefault;
    };
    decisions = {
      h.decided "build-on-rmw-token"
        "Use the token table and client role zenoh-rmw-token lands, and add only the answer and the listener admission"
        "two token tables and two client mechanisms would each need the other's rollback and sequence-number rules"
        h.agentDefault
        { "interest-answer"; "listener-admits-clients"; };
      h.decided "answer-in-the-session"
        "The session writes the answer while it applies the frame that asked, as the graph session writes its DeclareFinal"
        "the sequence number is spent only when the frame was built, and a refused frame must leave it untouched"
        h.agentDefault
        { "interest-answer"; };
      h.decided "grader-first"
        "The checker slice, the recipe and the host reference land in a planning pull request, and the implementation pull request changes only the paths in owns"
        "V3 keeps a grader out of the implementation pull request"
        h.agentDefault
        { "liveliness-wire"; };
    };
  };

item
