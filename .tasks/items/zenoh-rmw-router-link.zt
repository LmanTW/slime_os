s ::= import "./schema.zt";
h ::= import "./helpers.zt";

item :: s.Item = (h.task "01a20200-959c-702b-b450-13ce7e0dbece" "zenoh-rmw-router-link" "zenoh-transport"
  "A Profile 0 link takes the client role and delivers the samples a router forwards"
  "The client role lives on the session, and no link takes it. A router stamps every Put it forwards: the PUT header carries the timestamp flag, and a time and a 16-byte ID follow it. Every Profile 0 decoder refuses that header as `unsupported-message`. A link that opened a session with a router would end on its first forwarded sample. A host probe of a Slime client behind `rmw_zenohd` received a ROS talker's samples, and the decoder cannot read them.")
  with {
    owns = {
      "components/lib/src/zenoh_profile0.rs";
      "components/lib/src/zenoh_profile0/**";
      "components/lib/src/zenoh_link.rs";
      "components/lib/src/zenoh_link/**";
    };
    nonGoals = {
      h.nonGoal "A component, a composition, a system spec, a QEMU gate or a NIC. This item judges the link on the host over a scripted byte stream." h.agentDefault;
      h.nonGoal "A live router, a ROS install or a registry. The exam replays two runs that `rmw_zenohd` wrote." h.agentDefault;
      h.nonGoal "The graph link and the graph session. A router's liveliness tokens are not captured, and the graph link needs them." h.agentDefault;
      h.nonGoal "Writing a Put to a router. The captures show only what a router forwards to a subscriber." h.agentDefault;
      h.nonGoal "Delivering the router's timestamp. The link checks it and delivers the attachment's source timestamp, as it did for a peer's Put." h.agentDefault;
      h.nonGoal "A Put with the encoding flag, a forwarded sample larger than one frame, and a router that is not on its default configuration." h.agentDefault;
      h.nonGoal "Any change to what a link with no client role writes or accepts. The existing exams and the stock-peer exam pin it." h.agentDefault;
    };
    requirements = {
      h.req "client-link-subscribes-through-a-router"
        "A link with the client role writes the client INIT_SYN and takes the router's INIT_ACK. It then writes an OPEN_SYN that echoes the cookie and declares one subscription on the chatter key."
        { "zenoh_rmw_router_link_check"; };
      h.req "client-link-delivers-the-forwarded-samples"
        "Each captured run is written to the link whole, one byte at a time and all at once. Each way leaves 4 samples in the queue, in order, with sequence numbers 3 to 6 and the router's strings. The link counts no push as dropped."
        { "zenoh_rmw_router_link_check"; };
      h.req "client-link-closes-on-request"
        "A local close writes a CLOSE of reason 0 and leaves the queue with no sample."
        { "zenoh_rmw_router_link_check"; };
      h.req "timestamp-is-taken-only-with-the-role"
        "A PUT header with the timestamp flag is refused as `unsupported-message` by every decoder with no client role. The client decoder takes it only with a 16-byte ID, refuses a short ID as `malformed-message` and refuses the encoding flag as `unsupported-message`."
        { "zenoh_rmw_router_link_check"; "zenoh_session_check"; "zenoh_stock_check"; };
      h.req "listener-link-refuses-the-role"
        "A link built as a listener and asked for the client role is `invalid-config`."
        { "zenoh_rmw_router_link_check"; };
      h.req "controls-are-refused"
        "The judge refuses 111 corrupted records before it judges the real run: 101 mutated transcripts and 10 corrupted captures."
        { "zenoh_rmw_router_link_check"; };
    };
    acceptance = {
      h.observedWhere "zenoh_rmw_router_link_check" {
        h.count "casesObserved" 54;
        h.count "negativeControlsRefused" 111;
      };
      h.observed "zenoh_session_check";
      h.observed "zenoh_stock_check";
    };
    decisions = {
      h.decided "the-timestamp-is-an-opt-in-of-the-decoder"
        "The decoder takes the timestamp on a PUT only when the session has the client role. Every other decoder refuses it as it did."
        "the stock-peer exam pins what a peer session refuses, and a peer's direct Put carries no timestamp"
        h.agentDefault
        { "timestamp-is-taken-only-with-the-role"; };
      h.decided "the-router-timestamp-is-checked-not-delivered"
        "The decoder reads the router's time and 16-byte ID and delivers neither. The sample keeps the attachment's source timestamp."
        "the two timestamps differ in every capture, and a consumer reads the source timestamp of a peer's Put"
        h.agentDefault
        { "client-link-delivers-the-forwarded-samples"; };
      h.decided "the-role-reaches-the-link-by-a-call"
        "A link takes the client role through a builder call that passes it to its session. `Params` and `Config` stay as they are."
        "a new field on `Params` needs an edit in about a dozen files outside this item's `owns`"
        h.agentDefault
        { "client-link-subscribes-through-a-router"; "listener-link-refuses-the-role"; };
      h.decided "the-router-captures-are-two-runs-on-one-host"
        "The exam replays two runs of `rmw_zenohd` 0.6.10-r1 with a `demo_nodes_cpp` talker. They differ in the ZIDs, the cookies and the times."
        "the router wrote the INIT_ACK, the OPEN_ACK and the forwarded FRAMEs, and the client wrote the rest"
        h.agentDefault
        { "client-link-delivers-the-forwarded-samples"; };
    };
  };

item
