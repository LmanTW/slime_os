s ::= import "./schema.zt";
h ::= import "./helpers.zt";

item :: s.Item = (h.task "01a20b81-3467-7544-99d3-b431af5d2a89" "zenoh-rmw-discover-exam-repair" "zenoh-transport"
  "Repair the discover checker so a log line on the stdout of ros2 is not read as a node or topic name"
  "The first live run of `zenoh_rmw_discover_check` listed `/slime_node`, then failed. `ros2 node list` wrote a zenoh warning line to stdout before its list, and the checker read that line as a node name. A run against a bare router printed no such line in three attempts, so the line is intermittent.")
  with {
    intent = #active;
    depends = { "01a2095e-8c5f-717f-af72-60abb7f7ed80"; };
    owns = {
      "scripts/check/check-zenoh-profile0.py";
    };
    nonGoals = {
      h.nonGoal "Any change to the exam file, the case count or the control count of `zenoh-rmw-discover`. The exam judges the names the checker passes it." h.agentDefault;
      h.nonGoal "Suppressing the log line at its source, by an environment variable or a router option. The checker reads the output it is given." h.agentDefault;
      h.nonGoal "A change to any other slice of the checker. `rmw-live` reads the listener's lines with its own pattern." h.agentDefault;
    };
    requirements = {
      h.req "a-log-line-is-not-a-name"
        "The checker keeps a line of `ros2 node list` or `ros2 topic list` as a name only when it starts with `/`. A zenoh log line on stdout, with or without colour codes, is not read as a name."
        { "zenoh_rmw_discover_check"; };
    };
    acceptance = {
      h.observedWhere "zenoh_rmw_discover_check" {
        h.count "casesObserved" 8;
        h.count "negativeControlsRefused" 39;
      };
    };
    decisions = {
      h.decided "one-filter-and-no-count-change"
        "The repair adds one filter to `discover_names` in `scripts/check/check-zenoh-profile0.py`. The exam keeps 8 cases and 39 controls."
        "the exam's name pattern refuses a name that does not start with `/`. A log line that reached the exam would fail the run"
        h.agentDefault
        { "a-log-line-is-not-a-name"; };
    };
  };

item
